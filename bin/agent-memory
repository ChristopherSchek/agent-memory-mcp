# Stream reconfiguration for Unicode transport across all locales
for _stream in (sys.stdin, sys.stdout, sys.stderr):
    _reconf = getattr(_stream, "reconfigure", None)
    if callable(_reconf):
        try:
            _reconf(encoding="utf-8", errors="replace")
        except ValueError:
            pass

def _normalize_nfc(text: str) -> str:
    """Applies Unicode NFC normalization with a zero-import ASCII fast path to standardize stored text, preventing duplicate observations caused by canonically equivalent codepoints."""
    if text.isascii():
        return text
    import unicodedata
    return unicodedata.normalize("NFC", text)

def _normalize_nfkc(text: str) -> str:
    """Applies Unicode NFKC normalization with a zero-import ASCII fast path to canonicalize entity identifiers, preventing compatibility-character lookalikes from splitting graph nodes."""
    if text.isascii():
        return text
    import unicodedata
    return unicodedata.normalize("NFKC", text)

def _uuid4_str() -> str:
    """Generates a random UUIDv4 string via lazy module import to assign unique primary keys on write paths, avoiding import overhead during read-only search operations."""
    import uuid
    return str(uuid.uuid4())

# Fast zero-import RFC 3986 percent-encoder for SQLite file: URIs
_SAFE_PATH_BYTES = set(range(65, 91)) | set(range(97, 123)) | set(range(48, 58)) | set(b"_.-/~")
_PATH_BYTE_MAP = [chr(b) if b in _SAFE_PATH_BYTES else f"%{b:02X}" for b in range(256)]

def _pathname2url(pathname: str) -> str:
    """Encodes a filesystem path into an RFC 3986 URI path component to construct safe SQLite file URIs, preventing special characters such as question marks or hashes from corrupting URI query parameters."""
    if pathname.startswith("//"):
        pathname = "//" + pathname
    raw = pathname.encode("utf-8")
    return "".join(_PATH_BYTE_MAP[b] for b in raw)

if getattr(sys, "version_info", (0, 0)) < (3, 10):
    sys.exit("agent-memory requires Python 3.10 or newer.")

## Authoritative user context resolution via process EUID
try:
    _pw_entry = pwd.getpwuid(os.geteuid())
    AUTH_USER = _pw_entry.pw_name
    AUTH_HOME = _pw_entry.pw_dir
except (KeyError, OSError):
    import getpass
    AUTH_USER = os.environ.get("USER") or getpass.getuser()
    AUTH_HOME = os.path.expanduser("~")

USER = AUTH_USER
VERSION = "1.0.0"
# SCHEMA_VERSION is the on-disk storage format stamped into PRAGMA user_version.
# It MUST be monotonic across releases (pre-1.0 builds used 1..8), so the public
# "schema 1.0" label is kept separate from the internal storage counter.
SCHEMA_VERSION = 9
SCHEMA_VERSION_STR = "1.0"
LEGACY_MAX_FORMAT = 8          # pre-1.0 formats (no application_id) that can be migrated
APP_ID = 0x414D454D            # PRAGMA application_id ("AMEM") stamped into every agent-memory database
# Minimum SQLite: UPSERT (3.24), FTS5 and JSON1. Developed and tested on SQLite 3.46.
MIN_SQLITE_VERSION = (3, 31, 0)
_HAS_RETURNING = sqlite3.sqlite_version_info >= (3, 35, 0)

MAX_CONTENT_CHARS = 8000
MAX_SUMMARY_CHARS = 2000
MAX_NAME_CHARS = 200
MAX_TAGS = 50
MAX_TAG_CHARS = 100
MAX_QUERY_CHARS = 2000
MAX_ATTR_CHARS = 4000
MAX_SESSION_CHARS = 200

_TRUTHY = {"1", "true", "yes", "on"}
_JSON_EXT = "json"
_CFG_JSON = f"config.{_JSON_EXT}"
_SETTINGS_JSON = f"settings.{_JSON_EXT}"

def allow_non_optane() -> bool:
    """Checks whether ALLOW_NON_OPTANE is set to an explicit truthy value to permit non-Optane storage media, preventing accidental deployment onto unverified disks."""
    return os.environ.get("ALLOW_NON_OPTANE", "").strip().lower() in _TRUTHY

def _check_root_guard() -> None:
    """Verifies that real and effective UIDs and GIDs match at process startup to enforce user-level isolation, preventing SUID or SGID privilege escalation."""
    if os.getuid() != os.geteuid() or os.getgid() != os.getegid():
        raise RuntimeError("Privilege disparity detected (SUID/SGID execution is forbidden).")

_check_root_guard()

def _non_optane_default_db() -> str:
    """Resolves the XDG-compliant fallback database path to store user memory in non-Optane environments, preventing relative XDG_DATA_HOME values from placing databases in the current working directory."""
    data_home = os.environ.get("XDG_DATA_HOME") or ""
    if not os.path.isabs(data_home):
        base_home = AUTH_HOME if (AUTH_HOME and os.path.isabs(AUTH_HOME)) else os.path.expanduser("~")
        data_home = os.path.join(base_home, ".local", "share")
    return os.path.join(data_home, "agent-memory", "memory.db")

def _is_unhydrated_placeholder(val: str) -> bool:
    """Checks whether a configuration string contains unexpanded template tokens (`$`, `<user>`, or `__`) to reject raw template values, preventing unhydrated config templates from misrouting database paths."""
    s = val.strip()
    return not s or "$" in s or "<user>" in s.lower() or ("__" in s and s.count("__") >= 2)

# Fall back to registered client environment if running in a bare shell without explicit storage env vars
if (
    not os.environ.get("AGENT_MEMORY_DB")
    and not os.environ.get("OPTANE_BASE")
    and "ALLOW_NON_OPTANE" not in os.environ
    and not os.environ.get("AGENT_MEMORY_NO_CFG_FALLBACK")
):
    _candidate_client_cfgs: list[str] = []
    for _h in dict.fromkeys((AUTH_HOME, os.path.expanduser("~"))):
        if not _h or not os.path.isabs(_h):
            continue
        _candidate_client_cfgs.extend((
            os.path.join(_h, ".gemini", "config", f"mcp_{_CFG_JSON}"),
            os.path.join(_h, ".config", "Claude", f"claude_desktop_{_CFG_JSON}"),
            os.path.join(_h, "Library", "Application Support", "Claude", f"claude_desktop_{_CFG_JSON}"),
            os.path.join(_h, f".claude.{_JSON_EXT}"),
            os.path.join(_h, ".cursor", f"mcp.{_JSON_EXT}"),
            os.path.join(_h, ".codeium", "windsurf", f"mcp_{_CFG_JSON}"),
            os.path.join(_h, ".cline", "data", "settings", f"cline_mcp_{_SETTINGS_JSON}"),
            os.path.join(_h, ".config", "Code", "User", "globalStorage", "saoudrizwan.claude-dev", "settings", f"cline_mcp_{_SETTINGS_JSON}"),
        ))
    _euid = os.geteuid()
    for _client_cfg in _candidate_client_cfgs:
        if os.path.exists(_client_cfg):
            try:
                _st_l = os.lstat(_client_cfg)
                if _st_l.st_uid != _euid:
                    continue
                _st_c = os.stat(_client_cfg)
                if _st_c.st_uid != _euid or (_st_c.st_mode & 0o022) != 0:
                    continue
                with open(_client_cfg, "r", encoding="utf-8") as _f:
                    _c = json.load(_f)
                if not isinstance(_c, dict):
                    continue
                _servers = _c.get("mcpServers")
                _s = _servers.get("agent-memory") if isinstance(_servers, dict) else None
                _env = _s.get("env") if isinstance(_s, dict) else None
                if isinstance(_env, dict):
                    _db_val = _env.get("AGENT_MEMORY_DB")
                    if isinstance(_db_val, str) and not _is_unhydrated_placeholder(_db_val):
                        os.environ["AGENT_MEMORY_DB"] = _db_val.strip()
                        _allow_val = _env.get("ALLOW_NON_OPTANE")
                        if isinstance(_allow_val, (str, int, bool)) and "$" not in str(_allow_val):
                            os.environ["ALLOW_NON_OPTANE"] = str(_allow_val)
                        break
            except (OSError, ValueError, TypeError):
                pass

_raw_ob = os.environ.get("OPTANE_BASE")
if _raw_ob and not os.path.isabs(os.path.expanduser(os.path.expandvars(_raw_ob))):
    raise RuntimeError(f"OPTANE_BASE must be an absolute path (got '{_raw_ob}').")

def _has_usable_user_optane_dir() -> bool:
    """Checks whether `/mnt/optane/<user>` exists as a directory owned by the current effective UID without group or world write permissions, preventing unverified Optane directory auto-selection."""
    p = f"/mnt/optane/{USER}"
    try:
        st_l = os.lstat(p)
        if st_l.st_uid != os.geteuid() or stat.S_ISLNK(st_l.st_mode):
            return False
        st = os.stat(p)
        return stat.S_ISDIR(st.st_mode) and st.st_uid == os.geteuid() and (st.st_mode & 0o022) == 0
    except OSError:
        return False

# Database path precedence: AGENT_MEMORY_DB > $OPTANE_BASE/agent_memory/memory.db >
# /mnt/optane/<user>/agent_memory/memory.db. With ALLOW_NON_OPTANE and no per-user
# Optane directory, the default is $XDG_DATA_HOME (or ~/.local/share)/agent-memory/memory.db.
OPTANE_BASE = os.path.expanduser(os.path.expandvars(os.environ.get("OPTANE_BASE") or f"/mnt/optane/{USER}"))
_OPTANE_DEFAULT_DIR = os.path.join(OPTANE_BASE, "agent_memory")
if os.environ.get("AGENT_MEMORY_DB"):
    _RAW_DB_PATH = os.path.expanduser(os.path.expandvars(os.environ["AGENT_MEMORY_DB"]))
elif os.environ.get("OPTANE_BASE") or not allow_non_optane() or _has_usable_user_optane_dir():
    _RAW_DB_PATH = os.path.join(_OPTANE_DEFAULT_DIR, "memory.db")
else:
    _RAW_DB_PATH = _non_optane_default_db()
DB_PATH = os.path.realpath(os.path.abspath(_RAW_DB_PATH))
# Pre-canonicalized invariant path roots (resolved once at process bootstrap)
_MNT_OPTANE_REAL = os.path.realpath("/mnt/optane")
_RAW_AUTH_BASE = f"/mnt/optane/{AUTH_USER}"
_AUTH_BASE_REAL = os.path.realpath(_RAW_AUTH_BASE)
_OPTANE_BASE_REAL = os.path.realpath(OPTANE_BASE)
_VALIDATED_DIRS: set[str] = set()
_VALIDATED_DB_FILES: set[tuple[str, int, int, bool]] = set()
_STATVFS_CACHE: dict[str | int, int] = {}
_MOUNT_CACHE: dict[str, tuple[str, str]] = {}
_EMPTY_TAGS_JSON = "[]"
