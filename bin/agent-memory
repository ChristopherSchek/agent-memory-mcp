                "category": {"type": "string", "enum": _CATEGORIES_ENUM, "description": "Restrict to one category. May be used without query to list newest category facts."},
                "session_id": {"type": "string", "minLength": 1, "maxLength": MAX_SESSION_CHARS, "description": "Restrict to one session label."},
                "limit": {"type": "integer", "minimum": 1, "maximum": 100, "default": 10, "description": "Maximum results (1-100, default 10)."}
            },
            "required": [],
            "additionalProperties": False
        }
    },
    {
