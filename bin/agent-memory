#!/usr/bin/env python3
"""
agent-memory: per-user, Optane-backed knowledge graph and observation memory
for AI coding agents. Python 3.10+ standard library only.
Supports dual invocation: CLI commands and stdio JSON-RPC MCP server.
"""

import sys

if __name__ == "__main__" and len(sys.argv) == 2 and sys.argv[1] in ("--version", "-v"):
    print("agent-memory 1.0.0 (schema 1.0, storage format 9)")
    sys.exit(0)

import os
import sqlite3
import json
import re
import stat
import time
import signal

# Stream reconfiguration for bulletproof Unicode transport across all locales
try:
    sys.stdin.reconfigure(encoding="utf-8", errors="replace")
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    sys.stderr.reconfigure(encoding="utf-8", errors="replace")
except (AttributeError, ValueError):
    pass

def _normalize_nfc(text: str) -> str:
    """NFC normalization with zero-import fast path for ASCII."""
    if text.isascii():
        return text
    import unicodedata
    return unicodedata.normalize("NFC", text)

def _normalize_nfkc(text: str) -> str:
    """NFKC normalization with zero-import fast path for ASCII."""
    if text.isascii():
        return text
    import unicodedata
    return unicodedata.normalize("NFKC", text)

def _uuid4_str() -> str:
    """Lazy-load uuid to eliminate ~2.3ms of import overhead on search/read paths."""
    import uuid
    return str(uuid.uuid4())

# Fast zero-import RFC 3986 percent-encoder for SQLite file: URIs
_SAFE_PATH_BYTES = set(b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_.-/~")
_PATH_BYTE_MAP = [chr(b) if b in _SAFE_PATH_BYTES else f"%{b:02X}" for b in range(256)]

def _pathname2url(pathname: str) -> str:
    """Zero-import, byte-mapped pathname to URI path conversion."""
    if pathname.startswith("//"):
        pathname = "//" + pathname
    raw = pathname.encode("utf-8")
    return "".join(_PATH_BYTE_MAP[b] for b in raw)

if sys.version_info < (3, 10):
    sys.exit("agent-memory requires Python 3.10 or newer.")

# Authoritative user context resolution via process EUID
import pwd
try:
    AUTH_USER = pwd.getpwuid(os.geteuid()).pw_name
except Exception:
    import getpass
    AUTH_USER = os.environ.get("USER") or getpass.getuser()

USER = AUTH_USER
VERSION = "1.0.0"
# SCHEMA_VERSION is the on-disk storage format stamped into PRAGMA user_version.
# It MUST be monotonic across releases (pre-1.0 builds used 1..8), so the public
# "schema 1.0" label is kept separate from the internal storage counter.
SCHEMA_VERSION = 9
SCHEMA_VERSION_STR = "1.0"
LEGACY_MAX_FORMAT = 8          # pre-1.0 formats (no application_id) that can be migrated
APP_ID = 0x414D454D            # PRAGMA application_id ("AMEM") stamped into every agent-memory database
# Minimum SQLite: UPSERT (3.24), FTS5 and JSON1. Developed and tested on SQLite 3.46.
MIN_SQLITE_VERSION = (3, 31, 0)
_HAS_RETURNING = sqlite3.sqlite_version_info >= (3, 35, 0)

MAX_CONTENT_CHARS = 8000
MAX_SUMMARY_CHARS = 2000
MAX_NAME_CHARS = 200
MAX_TAGS = 50
MAX_TAG_CHARS = 100
MAX_QUERY_CHARS = 2000

_TRUTHY = {"1", "true", "yes", "on"}

def allow_non_optane() -> bool:
    """ALLOW_NON_OPTANE is enabled only by an explicit truthy value (1/true/yes/on)."""
    return os.environ.get("ALLOW_NON_OPTANE", "").strip().lower() in _TRUTHY

def _check_root_guard():
    """Refuse execution under SUID/SGID privilege disparity."""
    if os.getuid() != os.geteuid() or os.getgid() != os.getegid():
        raise RuntimeError("Privilege disparity detected (SUID/SGID execution is forbidden).")

_check_root_guard()

def _non_optane_default_db() -> str:
    data_home = os.environ.get("XDG_DATA_HOME") or ""
    if not os.path.isabs(data_home):
        data_home = os.path.join(os.path.expanduser("~"), ".local", "share")
    return os.path.join(data_home, "agent-memory", "memory.db")

# Fall back to registered client environment if running in a bare shell without env vars
if not os.environ.get("AGENT_MEMORY_DB"):
    _candidate_client_cfgs = [
        os.path.expanduser("~/.gemini/config/mcp_config.json"),
        os.path.expanduser("~/.config/Claude/claude_desktop_config.json"),
        os.path.expanduser("~/.claude.json"),
        os.path.expanduser("~/.cursor/mcp.json"),
        os.path.expanduser("~/.codeium/windsurf/mcp_config.json"),
    ]
    for _client_cfg in _candidate_client_cfgs:
        if os.path.exists(_client_cfg):
            try:
                with open(_client_cfg) as _f:
                    _c = json.load(_f)
                _s = _c.get("mcpServers", {}).get("agent-memory", {})
                _env = _s.get("env", {}) if isinstance(_s, dict) else {}
                if "AGENT_MEMORY_DB" in _env and "AGENT_MEMORY_DB" not in os.environ:
                    os.environ["AGENT_MEMORY_DB"] = _env["AGENT_MEMORY_DB"]
                if "ALLOW_NON_OPTANE" in _env and "ALLOW_NON_OPTANE" not in os.environ:
                    os.environ["ALLOW_NON_OPTANE"] = str(_env["ALLOW_NON_OPTANE"])
                if "AGENT_MEMORY_DB" in os.environ:
                    break
            except Exception:
                pass

_raw_ob = os.environ.get("OPTANE_BASE")
if _raw_ob and not os.path.isabs(os.path.expanduser(_raw_ob)):
    raise RuntimeError(f"OPTANE_BASE must be an absolute path (got '{_raw_ob}').")

# Database path precedence: AGENT_MEMORY_DB > $OPTANE_BASE/agent_memory/memory.db >
# /mnt/optane/<user>/agent_memory/memory.db; with ALLOW_NON_OPTANE and no per-user
# Optane directory the default is $XDG_DATA_HOME (or ~/.local/share)/agent-memory/memory.db.
OPTANE_BASE = os.path.expanduser(os.environ.get("OPTANE_BASE") or f"/mnt/optane/{USER}")
_OPTANE_DEFAULT_DIR = os.path.join(OPTANE_BASE, "agent_memory")
if os.environ.get("AGENT_MEMORY_DB"):
    _RAW_DB_PATH = os.path.expanduser(os.environ["AGENT_MEMORY_DB"])
elif os.environ.get("OPTANE_BASE") or not allow_non_optane() or os.path.isdir(f"/mnt/optane/{USER}"):
    _RAW_DB_PATH = os.path.join(_OPTANE_DEFAULT_DIR, "memory.db")
else:
    _RAW_DB_PATH = _non_optane_default_db()
DB_PATH = os.path.realpath(os.path.abspath(_RAW_DB_PATH))
# Pre-canonicalized invariant path roots (resolved once at process bootstrap)
_MNT_OPTANE_REAL = os.path.realpath("/mnt/optane")
_RAW_AUTH_BASE = f"/mnt/optane/{AUTH_USER}"
_AUTH_BASE_REAL = os.path.realpath(_RAW_AUTH_BASE)
_OPTANE_BASE_REAL = os.path.realpath(OPTANE_BASE)
_VALIDATED_DIRS: set[str] = set()
_VALIDATED_DB_FILES: set[str] = set()
_STATVFS_CACHE: dict[str | int, int] = {}
_MOUNT_CACHE: dict[str, tuple[str, str]] = {}
_EMPTY_TAGS_JSON = "[]"
_EMPTY_DICT: dict = {}
_NO_ID = object()
_MNT_ROOT_CHECKED: bool = False

# Directories created and owned by agent-memory itself; only these are forced to mode 0700.
MANAGED_DB_DIRS = {os.path.realpath(_OPTANE_DEFAULT_DIR),
                   os.path.realpath(os.path.join(f"/mnt/optane/{USER}", "agent_memory")),
                   os.path.realpath(os.path.dirname(_non_optane_default_db()))}

_ASCII_LOWER = str.maketrans("ABCDEFGHIJKLMNOPQRSTUVWXYZ", "abcdefghijklmnopqrstuvwxyz")

def nocase_key(s: str) -> str:
    """Case-fold exactly like SQLite COLLATE NOCASE (ASCII letters only)."""
    return s.translate(_ASCII_LOWER)

_SQLITE_FEATURES_CHECKED = False

def check_sqlite_features():
    """Fail fast with a clear message if the linked SQLite lacks required features."""
    global _SQLITE_FEATURES_CHECKED
    if _SQLITE_FEATURES_CHECKED:
        return
    if sqlite3.sqlite_version_info < MIN_SQLITE_VERSION:
        raise RuntimeError(
            f"SQLite {sqlite3.sqlite_version} is too old; agent-memory requires SQLite >= "
            f"{'.'.join(map(str, MIN_SQLITE_VERSION))} (UPSERT, FTS5 and JSON1 support).")
    probe = sqlite3.connect(":memory:")
    try:
        try:
            probe.execute("SELECT json_patch('{}', '{}')").fetchone()
        except sqlite3.Error as e:
            raise RuntimeError(f"Linked SQLite lacks the JSON1 functions required by agent-memory: {e}")
        try:
            probe.execute("CREATE VIRTUAL TABLE _fts_probe USING fts5(x)")
        except sqlite3.Error as e:
            raise RuntimeError(f"Linked SQLite lacks the FTS5 extension required by agent-memory: {e}")
    finally:
        probe.close()
    _SQLITE_FEATURES_CHECKED = True

VALID_CATEGORIES = {"architecture", "decision", "invariant", "preference", "debug_finding"}
VALID_ENTITY_TYPES = {"service", "repo", "pattern", "concept", "operator", "host"}

TABLE_STATEMENTS = [
    """CREATE TABLE IF NOT EXISTS entities (
    entity_id TEXT PRIMARY KEY,
    name TEXT NOT NULL UNIQUE COLLATE NOCASE,
    type TEXT NOT NULL COLLATE NOCASE CHECK(type IN ('service', 'repo', 'pattern', 'concept', 'operator', 'host')),
    summary TEXT,
    attributes TEXT CHECK(attributes IS NULL OR (json_valid(attributes) = 1 AND json_type(attributes) = 'object')),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);""",
    # seq is an INTEGER PRIMARY KEY (rowid alias) so the FTS5 content_rowid is stable
    # across VACUUM, dump/restore and backups.
    """CREATE TABLE IF NOT EXISTS observations (
    seq INTEGER PRIMARY KEY,
    observation_id TEXT NOT NULL UNIQUE,
    entity_id TEXT,
    entity_name TEXT COLLATE NOCASE,
    session_id TEXT DEFAULT 'default' COLLATE NOCASE,
    category TEXT NOT NULL COLLATE NOCASE DEFAULT 'architecture' CHECK(category IN ('architecture', 'decision', 'invariant', 'preference', 'debug_finding')),
    content TEXT NOT NULL,
    tags TEXT CHECK(tags IS NULL OR (json_valid(tags) = 1 AND json_type(tags) = 'array')),
    confidence REAL NOT NULL DEFAULT 1.0 CHECK(confidence >= 0.0 AND confidence <= 1.0),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY(entity_id) REFERENCES entities(entity_id) ON DELETE CASCADE
);""",
    "CREATE INDEX IF NOT EXISTS idx_observations_entity_created ON observations(entity_id, created_at DESC, seq DESC);",
    "CREATE INDEX IF NOT EXISTS idx_observations_entity_content ON observations(entity_id, content);",
    """CREATE TABLE IF NOT EXISTS relations (
    relation_id TEXT PRIMARY KEY,
    source_entity_id TEXT NOT NULL,
    target_entity_id TEXT NOT NULL,
    relation_type TEXT NOT NULL COLLATE NOCASE,
    weight REAL NOT NULL DEFAULT 1.0 CHECK(weight >= 0.0 AND weight <= 100.0),
    metadata TEXT CHECK(metadata IS NULL OR (json_valid(metadata) = 1 AND json_type(metadata) = 'object')),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY(source_entity_id) REFERENCES entities(entity_id) ON DELETE CASCADE,
    FOREIGN KEY(target_entity_id) REFERENCES entities(entity_id) ON DELETE CASCADE,
    CHECK(source_entity_id != target_entity_id),
    UNIQUE(source_entity_id, target_entity_id, relation_type)
);""",
    "CREATE INDEX IF NOT EXISTS idx_relations_source_sorted ON relations(source_entity_id, weight DESC, created_at DESC);",
    "CREATE INDEX IF NOT EXISTS idx_relations_target_sorted ON relations(target_entity_id, weight DESC, created_at DESC);",
]

FTS_STATEMENTS = [
    """CREATE VIRTUAL TABLE IF NOT EXISTS observations_fts USING fts5(
    content,
    category UNINDEXED,
    tags,
    entity_name,
    content='observations',
    content_rowid='seq',
    prefix='3',
    tokenize = 'porter unicode61 remove_diacritics 2'
);""",
    """CREATE TRIGGER IF NOT EXISTS observations_ai AFTER INSERT ON observations BEGIN
    INSERT INTO observations_fts(rowid, content, category, tags, entity_name)
    VALUES (new.seq, new.content, new.category, new.tags, new.entity_name);
END;""",
    """CREATE TRIGGER IF NOT EXISTS observations_ad AFTER DELETE ON observations BEGIN
    INSERT INTO observations_fts(observations_fts, rowid, content, category, tags, entity_name)
    VALUES ('delete', old.seq, old.content, old.category, old.tags, old.entity_name);
END;""",
    """CREATE TRIGGER IF NOT EXISTS observations_au AFTER UPDATE OF content, category, tags, entity_name ON observations BEGIN
    INSERT INTO observations_fts(observations_fts, rowid, content, category, tags, entity_name)
    VALUES ('delete', old.seq, old.content, old.category, old.tags, old.entity_name);
    INSERT INTO observations_fts(rowid, content, category, tags, entity_name)
    VALUES (new.seq, new.content, new.category, new.tags, new.entity_name);
END;""",
    """CREATE TRIGGER IF NOT EXISTS entities_au AFTER UPDATE OF name ON entities BEGIN
    UPDATE observations SET entity_name = new.name WHERE entity_id = new.entity_id;
END;""",
]

SCHEMA_STATEMENTS = TABLE_STATEMENTS + FTS_STATEMENTS
SCHEMA_DDL = "\n\n".join(SCHEMA_STATEMENTS)
CORE_TABLES = ("entities", "observations", "relations")
