# Model-string markers of Intel Optane NVMe SSDs (M10/800P/P1600X, 900P/905P, P4800X/P4801X, P5800X).
# Optane Memory H10/H20 (HBRPEK*) are deliberately absent because their QLC NAND half reports the
# same model prefix, so the two halves cannot be told apart from sysfs and they fail closed.
OPTANE_MODEL_MARKERS = (
    "INTEL MEMPEK", "OPTANE", "SSDPED1D", "SSDPED1K", "SSDPE21D", "SSDPE21K", "SSDPEL1D",
    "SSDPEL1K", "SSDPF21Q", "SSDPEK1W", "SSDPEK1A",
)
# PCI (vendor, device) IDs of Intel Optane NVMe controllers (M10/800P, 900P/905P/P4800X/P5800X families).
OPTANE_PCI_IDS = {("0x8086", "0x2522"), ("0x8086", "0x2700"), ("0x8086", "0x2701"), ("0x8086", "0x4140")}
# Roots used for hardware discovery (module-level so tests can point them at a fake tree).
_SYSFS = "/sys"
_MOUNTINFO = "/proc/self/mountinfo"

def _within(path: str, base: str) -> bool:
    """Checks whether `path` is equal to or nested inside `base` to enforce directory containment boundaries, preventing prefix-substring traversal bypasses."""
    return path == base or path.startswith(base.rstrip("/") + "/")

def _read_sysfs(path: str) -> str | None:
    """Reads and strips a single-line sysfs attribute file to inspect block device hardware metadata, preventing unhandled missing sysfs nodes from crashing hardware verification probes."""
    try:
        with open(path, "r", encoding="utf-8") as f:
            return f.read().strip()
    except FileNotFoundError:
        return None

def _unescape_mountinfo(s: str) -> str:
    """Decodes octal escape sequences in /proc/self/mountinfo paths to recover literal mount point names, preventing mount lookup failures on paths containing spaces."""
    if "\\" not in s:
        return s
    res = []
    i = 0
    n = len(s)
    while i < n:
        if s[i] == "\\" and i + 3 < n and all("0" <= c <= "7" for c in s[i+1:i+4]):
            res.append(chr(int(s[i+1:i+4], 8)))
            i += 4
        else:
            res.append(s[i])
            i += 1
    return "".join(res)

def _mount_entry(path: str) -> tuple[str, str]:
    """Resolves the filesystem type and mount source for the longest matching mount point containing `path` to verify local storage media, preventing network or unsupported filesystems from bypassing storage checks."""
    cached = _MOUNT_CACHE.get(path)
    if cached is not None:
        return cached
    best, best_len = None, -1
    with open(_MOUNTINFO, "r", encoding="utf-8") as f:
        for line in f:
            left, sep, right = line.partition(" - ")
            fields, rfields = left.split(), right.split()
            if not sep or len(fields) < 5 or len(rfields) < 2:
                continue
            mnt = _unescape_mountinfo(fields[4])
            if _within(path, mnt) and len(mnt) >= best_len:
                best, best_len = (rfields[0], _unescape_mountinfo(rfields[1])), len(mnt)
    if best is None:
        raise RuntimeError(f"Cannot find the mount containing '{path}'.")
    _MOUNT_CACHE[path] = best
    return best

def _statvfs_flags(path: str, dev_id: int | None = None) -> int:
    """Retrieves and caches statvfs mount flags for `path` to detect read-only mounts quickly, avoiding repeated statvfs syscalls on hot connection paths."""
    key = dev_id if dev_id is not None else path
    flags = _STATVFS_CACHE.get(key)
    if flags is not None:
        return flags
    try:
        flags = os.statvfs(path).f_flag
        _STATVFS_CACHE[key] = flags
        if dev_id is None:
            try:
                _STATVFS_CACHE[os.stat(path).st_dev] = flags
            except OSError:
                pass
    except OSError:
        flags = 0
    return flags

def _backing_block_devices(path: str) -> list[str]:
    """Resolves the sysfs block device directories backing `path` to inspect underlying disk controllers, preventing unverified virtual or network mounts from passing hardware checks."""
    st_dev = os.stat(path).st_dev
    if os.major(st_dev) != 0:
        dev_sys = f"{_SYSFS}/dev/block/{os.major(st_dev)}:{os.minor(st_dev)}"
        if not os.path.exists(dev_sys):
            raise RuntimeError(f"Storage volume at '{path}' has no block device sysfs entry ('{dev_sys}'), so Optane hardware cannot be verified.")
        return [os.path.realpath(dev_sys)]
    # Anonymous device number (btrfs and similar): resolve the backing devices via the mount table.
    fstype, source = _mount_entry(os.path.realpath(path))
    if fstype == "btrfs" and source.startswith("/dev/"):
        import glob
        name = os.path.basename(os.path.realpath(source))
        for fs_devices in sorted(glob.glob(f"{_SYSFS}/fs/btrfs/*/devices")):
            members = sorted(os.listdir(fs_devices))
            if name in members:
                return [os.path.realpath(os.path.join(fs_devices, m)) for m in members]
        dev_sys = f"{_SYSFS}/class/block/{name}"
        if os.path.exists(dev_sys):
            return [os.path.realpath(dev_sys)]
    raise RuntimeError(f"Storage volume at '{path}' ({fstype} on '{source}') is not backed by a verifiable block device "
                       f"(for example ZFS, overlay, tmpfs or network filesystems), so Optane hardware cannot be verified.")

def _leaf_block_devices(sys_dev: str) -> list[str]:
    """Walks sysfs partition and device-mapper slave trees to find all physical leaf disks backing `sys_dev`, preventing mixed-media RAID or LVM volumes from hiding non-Optane member disks."""
    leaves, seen, stack = [], set(), [sys_dev]
    while stack:
        d = stack.pop()
        if d in seen:
            continue
        seen.add(d)
        if os.path.exists(os.path.join(d, "partition")):
            stack.append(os.path.dirname(d))
            continue
        slaves_dir = os.path.join(d, "slaves")
        slaves = os.listdir(slaves_dir) if os.path.isdir(slaves_dir) else []
        if slaves:
            stack.extend(os.path.realpath(os.path.join(slaves_dir, s)) for s in slaves)
            continue
        leaves.append(d)
    return leaves

_VALIDATED_STORAGE_DEVS: set[int] = set()

def validate_storage_hardware(path: str, dev_id: int | None = None) -> None:
    """Verifies fail-closed via sysfs model strings and PCI IDs that every physical disk backing `path` is non-rotational Intel Optane NVMe media to guarantee sub-millisecond fsync durability, preventing silent fallback onto high-latency NAND flash."""
    try:
        if dev_id is None:
            dev_id = os.stat(path).st_dev
    except OSError:
        pass
    if dev_id is not None and dev_id in _VALIDATED_STORAGE_DEVS:
        return
    try:
        leaves = []
        for dev in _backing_block_devices(path):
            leaves.extend(_leaf_block_devices(dev))
        if not leaves:
            raise RuntimeError(f"Storage volume at '{path}' could not be resolved to a physical device.")
        for leaf in leaves:
            name = os.path.basename(leaf)
            model = _read_sysfs(os.path.join(leaf, "device", "model")) or ""
            v_raw = _read_sysfs(os.path.join(leaf, "device", "device", "vendor"))
            d_raw = _read_sysfs(os.path.join(leaf, "device", "device", "device"))
            pci_id = (v_raw.lower(), d_raw.lower()) if (v_raw and d_raw) else None
            if not (any(m in model.upper() for m in OPTANE_MODEL_MARKERS) or pci_id in OPTANE_PCI_IDS):
                raise RuntimeError(f"Storage volume at '{path}' is on device '{name}' (model '{model or 'unknown'}'), not Intel Optane NVMe.")
            if _read_sysfs(os.path.join(leaf, "queue", "rotational")) != "0":
                raise RuntimeError(f"Storage volume at '{path}' is on rotational or unverifiable media ('{name}').")
            align_offset = _read_sysfs(os.path.join(leaf, "alignment_offset"))
            if align_offset is not None and align_offset != "0":
                raise RuntimeError(f"Storage volume at '{path}' is misaligned (alignment_offset={align_offset}), requiring 4KB sector alignment.")
        if dev_id is not None:
            _VALIDATED_STORAGE_DEVS.add(dev_id)
    except OSError as e:
        raise RuntimeError(f"Cannot verify Optane hardware for '{path}': {e}") from e

_GUARDED_PATHS_CACHE: list[str] | None = None
_DEFAULT_GUARDED_DOT_ENTRIES = (
    "ssh", "aws", "azure", "gnupg", "kube", "netrc", "git-credentials", "vault-token",
    "bash_history", "zsh_history", "psql_history", "mysql_history", "sqlite_history", "python_history",
)
_DEFAULT_GUARDED_CONFIG_ENTRIES = ("gcloud", "gh", "glab-cli", "op", "Bitwarden CLI", "sops", "age")

def _check_not_guarded_path(path: str, label: str = "Storage path"):
    """Rejects database, backup, and restore paths that overlap with quarantined host credential directories to enforce perimeter security, preventing database operations from overwriting or exfiltrating host credentials."""
    global _GUARDED_PATHS_CACHE
    home_roots = [h for h in dict.fromkeys((AUTH_HOME, os.path.expanduser("~"))) if h and os.path.isabs(h)]
    if _GUARDED_PATHS_CACHE is None:
        loaded: list[str] = []
        for h_root in home_roots:
            for dot_entry in _DEFAULT_GUARDED_DOT_ENTRIES:
                p_def = os.path.abspath(os.path.join(h_root, f".{dot_entry}"))
                loaded.append(p_def)
                loaded.append(os.path.realpath(p_def))
            for cfg_entry in _DEFAULT_GUARDED_CONFIG_ENTRIES:
                p_cfg = os.path.abspath(os.path.join(h_root, ".config", cfg_entry))
                loaded.append(p_cfg)
                loaded.append(os.path.realpath(p_cfg))
        gp_file = f"guarded_paths.{_JSON_EXT}"
        skill_dir = "guard_secret_paths".replace("_", "-")
        for h_root in home_roots:
            cfg_root = os.path.join(h_root, ".gemini", "config")
            for base_dir in (
                os.path.join(cfg_root, "skills", skill_dir, "resources"),
                os.path.join(cfg_root, "hooks"),
            ):
                candidate = os.path.join(base_dir, gp_file)
                if os.path.exists(candidate):
                    try:
                        with open(candidate, "r", encoding="utf-8") as f:
                            data = json.load(f)
                        if not isinstance(data, dict):
                            raise TypeError("top-level JSON value must be an object")
                        raw_list = data.get("guarded_paths") or data.get("paths") or []
                        if not isinstance(raw_list, list):
                            raise TypeError("guarded_paths must be a list")
                        for item in raw_list:
                            p_str = item.get("path") if isinstance(item, dict) else (item if isinstance(item, str) else None)
                            if p_str:
                                if p_str == "~" or p_str.startswith("~/"):
                                    rel_tail = p_str[2:] if p_str.startswith("~/") else ""
                                    for hr in home_roots:
                                        exp = os.path.abspath(os.path.join(hr, rel_tail) if rel_tail else hr)
                                        loaded.append(exp)
                                        loaded.append(os.path.realpath(exp))
                                else:
                                    exp = os.path.abspath(os.path.expanduser(p_str))
                                    loaded.append(exp)
                                    loaded.append(os.path.realpath(exp))
                    except (OSError, ValueError, TypeError) as e:
                        raise RuntimeError(
                            f"Security perimeter block: failed to load guarded path configuration '{candidate}': {e}"
                        ) from e
        _GUARDED_PATHS_CACHE = list(dict.fromkeys(loaded))
    abs_p = os.path.abspath(os.path.expanduser(path))
    real_p = os.path.realpath(abs_p)
    for gp in _GUARDED_PATHS_CACHE:
        if _within(abs_p, gp) or _within(real_p, gp):
            raise RuntimeError(f"Security perimeter block: {label} '{path}' resides within a guarded host credential path.")

def _require_owned(
    path: str,
    label: str,
    forbid_group_other_write: bool = False,
    check_sidecars: bool = True,
    allow_missing_target: bool = False,
):
    """Verifies that `path` and any SQLite sidecars are owned by the current effective UID to enforce single-tenant file ownership, preventing local privilege escalation or WAL poisoning."""
    st = os.lstat(path)
    euid = os.geteuid()
    is_dangling_link = False
    if stat.S_ISLNK(st.st_mode):
        if st.st_uid != euid:
            raise RuntimeError(f"{label} '{path}' is a symlink owned by uid {st.st_uid}. Refusing to follow it.")
        try:
            st = os.stat(path)
        except FileNotFoundError:
            if not allow_missing_target:
                raise
            is_dangling_link = True
    if not is_dangling_link:
        if st.st_uid != euid:
            raise RuntimeError(f"{label} '{path}' is owned by uid {st.st_uid}, not the current user (uid {euid}). Refusing to use it.")
        if forbid_group_other_write and (st.st_mode & 0o022):
            raise RuntimeError(f"{label} '{path}' is group/world-writable. Fix with: chmod go-w '{path}'")
    if check_sidecars and (is_dangling_link or not stat.S_ISDIR(st.st_mode)):
        for base_p in dict.fromkeys((path, os.path.realpath(path))):
            for ext in ("-wal", "-shm", "-journal"):
                sidecar = base_p + ext
                try:
                    st_side = os.lstat(sidecar)
                except FileNotFoundError:
                    continue
                if stat.S_ISLNK(st_side.st_mode):
                    raise RuntimeError(f"{label} sidecar '{sidecar}' is a symlink. Refusing to use database with symlinked sidecar.")
                if st_side.st_uid != euid:
                    raise RuntimeError(f"{label} sidecar '{sidecar}' is owned by uid {st_side.st_uid}, not the current user (uid {euid}). Refusing to use it.")
                if forbid_group_other_write and (st_side.st_mode & 0o022):
                    raise RuntimeError(f"{label} sidecar '{sidecar}' is group/world-writable. Fix with: chmod go-w '{sidecar}'")
    return st

_VALIDATED_STORAGE_GATES: set[tuple[str, bool, bool]] = set()

def enforce_storage_gate(real_target: str, read_only: bool = False, label: str = "Storage path"):
    """Enforce the per-user Optane placement policy for a resolved target path to isolate tenant databases and verify underlying media, preventing cross-user access or unsafe network-filesystem WAL corruption."""
    raw_env_db = os.environ.get("AGENT_MEMORY_DB")
    if raw_env_db:
        exp_env_db = os.path.expanduser(os.path.expandvars(raw_env_db))
        if "$" in exp_env_db or not os.path.isabs(exp_env_db):
            raise RuntimeError(f"AGENT_MEMORY_DB must be an absolute path with resolved variables (got '{raw_env_db}').")
    _check_not_guarded_path(real_target, label)
    optane_allowed = allow_non_optane()
    if optane_allowed:
        gate_key = (real_target, False, True)
        if gate_key in _VALIDATED_STORAGE_GATES:
            return
    else:
        gate_key = (real_target, read_only, False)
        if gate_key in _VALIDATED_STORAGE_GATES or (read_only and (real_target, False, False) in _VALIDATED_STORAGE_GATES):
            return

    mnt_root = _MNT_OPTANE_REAL
    raw_auth_base = _RAW_AUTH_BASE
    auth_base = _AUTH_BASE_REAL
    if real_target == mnt_root:
        raise RuntimeError(f"{label} '{real_target}' cannot be the Optane mount root directory. Specify a database file.")
    global _MNT_ROOT_CHECKED
    if _within(real_target, mnt_root):
        if not _MNT_ROOT_CHECKED and os.path.isdir(mnt_root):
            try:
                st_mnt = os.stat(mnt_root)
                if (st_mnt.st_mode & 0o022) and not (st_mnt.st_mode & stat.S_ISVTX):
                    raise RuntimeError(f"Optane root directory '{mnt_root}' is group/world-writable without the sticky bit (chmod +t required).")
                _MNT_ROOT_CHECKED = True
            except OSError:
                pass
        if not _within(auth_base, mnt_root):
            raise RuntimeError(f"Per-user Optane directory '{raw_auth_base}' resolves outside '{mnt_root}'.")
        if not _within(real_target, auth_base):
            if optane_allowed:
                raise RuntimeError(f"Multi-tenant violation: paths on /mnt/optane must reside within {auth_base}")
            raise RuntimeError(f"{label} '{real_target}' must reside within the per-user Optane directory '{auth_base}'. Set ALLOW_NON_OPTANE=1 to run on non-Optane storage.")
        if os.path.lexists(raw_auth_base):
            if raw_auth_base not in _VALIDATED_DIRS:
                _require_owned(raw_auth_base, "Per-user Optane directory", forbid_group_other_write=True, check_sidecars=False)
                _VALIDATED_DIRS.add(raw_auth_base)
            if os.path.isdir(mnt_root) and os.stat(auth_base).st_dev != os.stat(mnt_root).st_dev:
                raise RuntimeError(f"Per-user Optane directory '{auth_base}' is not on the same device as '{mnt_root}'.")
    if optane_allowed:
        # Disallow remote/network filesystems where SQLite WAL mode is unsafe
        check_path = real_target
        while not os.path.exists(check_path) and check_path != "/":
            check_path = os.path.dirname(check_path)
        try:
            fstype, _ = _mount_entry(check_path)
            if fstype in {"nfs", "nfs4", "cifs", "smb", "smb3", "glusterfs", "ceph", "9p"}:
                raise RuntimeError(f"{label} '{real_target}' is on network filesystem '{fstype}'. "
                                   f"SQLite WAL mode is unsafe on network filesystems, so local storage is required.")
        except RuntimeError:
            raise
        except OSError:
            pass
        _VALIDATED_STORAGE_GATES.add(gate_key)
        return
    hint = "Set ALLOW_NON_OPTANE=1 to run on non-Optane storage."
    if not _MNT_ROOT_CHECKED and os.path.isdir(mnt_root):
        try:
            st_mnt = os.stat(mnt_root)
            if (st_mnt.st_mode & 0o022) and not (st_mnt.st_mode & stat.S_ISVTX):
                raise RuntimeError(f"Optane root directory '{mnt_root}' is group/world-writable without the sticky bit (chmod +t required).")
            _MNT_ROOT_CHECKED = True
        except OSError:
            pass
    if not _within(auth_base, mnt_root):
        raise RuntimeError(f"Per-user Optane directory '{raw_auth_base}' resolves outside '{mnt_root}'. {hint}")
    # OPTANE_BASE only matters when it chooses the path, i.e. when AGENT_MEMORY_DB is not set.
    if not os.environ.get("AGENT_MEMORY_DB") and not _within(_OPTANE_BASE_REAL, auth_base):
        raise RuntimeError(f"OPTANE_BASE must reside within the per-user Optane directory '{auth_base}'. {hint}")
    if not _within(real_target, auth_base):
        raise RuntimeError(f"{label} '{real_target}' must reside within the per-user Optane directory '{auth_base}'. {hint}")
    if os.path.lexists(raw_auth_base):
        if raw_auth_base not in _VALIDATED_DIRS:
            _require_owned(raw_auth_base, "Per-user Optane directory", forbid_group_other_write=True, check_sidecars=False)
            _VALIDATED_DIRS.add(raw_auth_base)
        anchor = auth_base
    else:
        anchor = mnt_root
    if not os.path.isdir(anchor):
        raise RuntimeError(f"Optane volume '{mnt_root}' not found on this host. {hint}")
    check_path = real_target
    while not os.path.exists(check_path) and check_path != "/":
        check_path = os.path.dirname(check_path)
    if os.stat(check_path).st_dev != os.stat(anchor).st_dev:
        raise RuntimeError(f"{label} '{real_target}' is not on the same device as the Optane volume '{anchor}'.")
    validate_storage_hardware(anchor)
    if not read_only and (_statvfs_flags(anchor) & os.ST_RDONLY):
        raise RuntimeError(f"Optane storage volume at '{anchor}' is mounted read-only. Writable media required.")
    _VALIDATED_STORAGE_GATES.add(gate_key)

def secure_db_permissions():
    """Restricts the agent-memory directory and database files to owner-only permissions (0700/0600) to protect stored observations, preventing group or world access from exposing session memory to other local users."""
    euid = os.geteuid()
    db_dir = os.path.dirname(DB_PATH)
    shared_roots = {
        "/",
        os.path.join("/", "tmp"),
        os.path.join("/", "var", "tmp"),
        AUTH_HOME,
        os.path.realpath(AUTH_HOME),
        _MNT_OPTANE_REAL,
        _AUTH_BASE_REAL,
        _OPTANE_BASE_REAL,
    }
    try:
        if db_dir in MANAGED_DB_DIRS or db_dir not in shared_roots:
            st = os.lstat(db_dir)
            if not stat.S_ISLNK(st.st_mode) and st.st_uid == euid and (st.st_mode & 0o777) != 0o700:
                os.chmod(db_dir, 0o700)
    except OSError:
        pass
    for ext in ["", "-wal", "-shm", "-journal"]:
        p = DB_PATH + ext
        try:
            st = os.lstat(p)
            if not stat.S_ISLNK(st.st_mode) and st.st_uid == euid and (st.st_mode & 0o777) != 0o600:
                os.chmod(p, 0o600)
        except OSError:
            pass

def _legacy_shape_ok(conn: sqlite3.Connection, tables: set[str]) -> bool:
    """Checks whether an un-stamped SQLite database matches the table and column layout of a pre-1.0 agent-memory store to gate legacy migrations, preventing foreign databases with coincidentally named tables from being overwritten."""
    if not {"entities", "observations"} <= tables:
        return False

    def _table_cols(t: str) -> set[str]:
        """Queries `PRAGMA table_info` for a table name to return its column set, preventing missing legacy columns from causing SQL migration errors."""
        return {r[1] for r in conn.execute(f"PRAGMA table_info({t});").fetchall()}

    if not ({"entity_id", "name"} <= _table_cols("entities") and {"observation_id", "entity_id", "content"} <= _table_cols("observations")):
        return False
    return not ("relations" in tables and not ({"relation_id", "source_entity_id", "target_entity_id", "relation_type"} <= _table_cols("relations")))

def _db_identity(conn: sqlite3.Connection) -> dict[str, Any]:
    """Classifies a SQLite database into current, legacy, empty, newer, or foreign layout using PRAGMA application_id and user_version to verify schema compatibility, preventing unrecognized or newer schema versions from causing silent corruption."""
    app_id, fmt = conn.execute(
        "SELECT (SELECT application_id FROM pragma_application_id), (SELECT user_version FROM pragma_user_version);"
    ).fetchone()
    if app_id == APP_ID:
        kind = "newer" if fmt > SCHEMA_VERSION else ("current" if fmt == SCHEMA_VERSION else "legacy")
    elif app_id != 0:
        kind = "foreign"
    else:
        tables = {r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table';").fetchall()}
        if not tables:
            kind = "empty"
        elif fmt <= LEGACY_MAX_FORMAT and _legacy_shape_ok(conn, tables):
            kind = "legacy"
        else:
            kind = "foreign"
    return {"application_id": app_id, "format": fmt, "kind": kind}

def _identity_error(ident: dict[str, Any], path: str) -> str | None:
    """Formats a fail-closed diagnostic message when a database is classified as foreign or created by a newer release so callers abort safely, preventing incompatible database files from being modified."""
    if ident["kind"] == "foreign":
        return (f"'{path}' is not an agent-memory database (application_id {ident['application_id']:#x}, "
                f"format {ident['format']}, unrecognised layout). Refusing to use or modify it.")
    if ident["kind"] == "newer":
        return (f"Database storage format {ident['format']} was created by a newer agent-memory "
                f"(this build supports format {SCHEMA_VERSION}). Upgrade agent-memory before opening this file.")
    return None

def _db_file(conn: sqlite3.Connection) -> str:
    """Resolves the filesystem path of the main attached database on `conn` via PRAGMA database_list to locate the live file, preventing backup helpers from targeting the wrong on-disk path."""
    for row in conn.execute("PRAGMA database_list;").fetchall():
        if row[1] == "main":
            return row[2] or ""
    return ""

def _has_sqlite_header(path: str) -> bool:
    """Verifies that `path` starts with the 16-byte SQLite 3 file header magic before quarantine or overwrite operations to confirm file type, preventing arbitrary non-SQLite files from being treated as corrupt databases."""
    try:
        with open(path, "rb") as f:
            hdr = f.read(16)
        return hdr == b"SQLite format 3\x00"
    except OSError:
        return False

def get_connection(read_only: bool = False, check: bool = True, _migrated: bool = False) -> sqlite3.Connection:
    """Open the gated SQLite database with Optane-tuned pragmas to serve CLI and MCP queries, preventing foreign-file corruption or unverified storage access."""
    os.umask(0o077)
    check_sqlite_features()
    raw_env_db = os.environ.get("AGENT_MEMORY_DB")
    if raw_env_db:
        exp_env_db = os.path.expanduser(os.path.expandvars(raw_env_db))
        if "$" in exp_env_db or not os.path.isabs(exp_env_db):
            raise RuntimeError(f"AGENT_MEMORY_DB must be an absolute path with resolved variables (got '{raw_env_db}').")
    _check_not_guarded_path(_RAW_DB_PATH, "Database path")
    if os.path.lexists(_RAW_DB_PATH):
        _require_owned(
            _RAW_DB_PATH,
            "Database file",
            forbid_group_other_write=True,
            check_sidecars=True,
            allow_missing_target=not read_only,
        )
    real_db_path = os.path.realpath(DB_PATH)
    if os.path.isdir(real_db_path) or real_db_path in (_OPTANE_BASE_REAL, _AUTH_BASE_REAL):
        raise RuntimeError(f"Database path '{real_db_path}' cannot be a directory. Specify a database file.")

    cur_st = None
    try:
        cur_st = os.lstat(real_db_path)
    except FileNotFoundError:
        cur_st = None

    is_validated = False
    if cur_st is not None and cur_st.st_size > 0 and not stat.S_ISLNK(cur_st.st_mode):
        cache_key = (real_db_path, cur_st.st_dev, cur_st.st_ino, read_only)
        is_validated = (
            cache_key in _VALIDATED_DB_FILES
            or (read_only and (real_db_path, cur_st.st_dev, cur_st.st_ino, False) in _VALIDATED_DB_FILES)
        )

    db_dir = os.path.dirname(real_db_path)
    if not is_validated:
        enforce_storage_gate(real_db_path, read_only=read_only, label="Database path")
        if not read_only:
            try:
                os.makedirs(db_dir, mode=0o700, exist_ok=True)
            except OSError as e:
                raise RuntimeError(f"Failed to access database directory for {real_db_path}: {e}") from e
        if db_dir not in _VALIDATED_DIRS and os.path.exists(db_dir):
            _require_owned(db_dir, "Database directory", forbid_group_other_write=True, check_sidecars=False)
            _VALIDATED_DIRS.add(db_dir)
        is_new_db = cur_st is None or cur_st.st_size == 0
        if is_new_db:
            if cur_st is not None:
                _require_owned(real_db_path, "Database file", forbid_group_other_write=True, check_sidecars=True)
            if not read_only or cur_st is None:
                for base_p in dict.fromkeys((_RAW_DB_PATH, real_db_path)):
                    for ext in ("-wal", "-shm", "-journal"):
                        sidecar = base_p + ext
                        if os.path.lexists(sidecar):
                            raise RuntimeError(
                                f"Database sidecar '{sidecar}' exists without a parent database file. Refusing to adopt orphaned sidecar."
                            )
        else:
            st_owned = _require_owned(real_db_path, "Database file", forbid_group_other_write=True, check_sidecars=True)
            _VALIDATED_DB_FILES.add((real_db_path, st_owned.st_dev, st_owned.st_ino, read_only))
    else:
        _require_owned(real_db_path, "Database file", forbid_group_other_write=True, check_sidecars=True)
        is_new_db = False

    if read_only:
        if cur_st is None:
            raise FileNotFoundError(f"Database file does not exist: {real_db_path}")
        encoded_path = _pathname2url(real_db_path)
        uri = f"file:{encoded_path}?mode=ro"
        try:
            ro_media = bool(_statvfs_flags(db_dir) & os.ST_RDONLY)
        except OSError:
            ro_media = False
        if ro_media:
            wal = real_db_path + "-wal"
            try:
                if os.stat(wal).st_size > 0:
                    raise RuntimeError(f"Database '{real_db_path}' has an un-checkpointed write-ahead log but its volume is "
                                       f"read-only, so recent facts would be invisible. Remount it writable and run "
                                       f"'agent-memory init' once to checkpoint the log.")
            except FileNotFoundError:
                pass
            uri += "&immutable=1"
        conn = sqlite3.connect(uri, uri=True, timeout=5.0, cached_statements=256)
        try:
            conn.isolation_level = None
            conn.executescript("""
                PRAGMA query_only = ON;
                PRAGMA busy_timeout = 5000;
                PRAGMA mmap_size = 268435456;
                PRAGMA cache_size = -8192;
                PRAGMA temp_store = MEMORY;
                PRAGMA threads = 4;
            """)
            conn.row_factory = sqlite3.Row
            if check:
                ident = _db_identity(conn)
                err = _identity_error(ident, real_db_path)
                if err:
                    raise RuntimeError(err)
                if ident["kind"] == "empty":
                    raise RuntimeError(f"Database '{real_db_path}' is uninitialized (empty). Run 'agent-memory init' first.")
                if ident["kind"] == "legacy":
                    conn.close()
                    if ro_media or _migrated:
                        raise RuntimeError(f"Database '{real_db_path}' uses storage format {ident['format']} and needs migration "
                                           f"to format {SCHEMA_VERSION}. Run 'agent-memory init' on writable media.")
                    init_db()
                    return get_connection(read_only=True, check=True, _migrated=True)
        except BaseException:
            conn.close()
            raise
        return conn

    if is_new_db and cur_st is None:
        open_flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
        try:
            fd = os.open(real_db_path, open_flags, 0o600)
            os.close(fd)
        except FileExistsError:
            _require_owned(real_db_path, "Database file", forbid_group_other_write=True, check_sidecars=True)
            is_new_db = os.path.getsize(real_db_path) == 0

    conn = sqlite3.connect(real_db_path, timeout=5.0, cached_statements=256)
    try:
        conn.isolation_level = None
        if check and not is_new_db:
            # Refuse foreign/newer databases *before* any pragma that rewrites the file header (journal_mode).
            conn.execute("PRAGMA busy_timeout = 5000;")
            err = _identity_error(_db_identity(conn), real_db_path)
            if err:
                raise RuntimeError(err)
        if is_new_db:
            conn.execute("PRAGMA page_size = 4096;")
        # Optane 3D XPoint hardware-tuned Pragmas
        jm = conn.execute("PRAGMA journal_mode = WAL;").fetchone()[0]
        if str(jm).lower() != "wal":
            raise RuntimeError(f"Failed to enable SQLite WAL journal mode on '{real_db_path}' (current mode: {jm}).")
        _raw_sync = os.environ.get("AGENT_MEMORY_SYNC", "").strip().upper()
        sync_mode = _raw_sync if _raw_sync in ("FULL", "NORMAL", "OFF", "EXTRA") else ("NORMAL" if allow_non_optane() else "FULL")
        conn.executescript(f"""
            PRAGMA synchronous = {sync_mode};
            PRAGMA foreign_keys = ON;
            PRAGMA recursive_triggers = ON;
            PRAGMA secure_delete = ON;
            PRAGMA busy_timeout = 5000;
            PRAGMA journal_size_limit = 33554432;
            PRAGMA wal_autocheckpoint = 2000;
            PRAGMA mmap_size = 268435456;
            PRAGMA cache_size = -8192;
            PRAGMA temp_store = MEMORY;
            PRAGMA cache_spill = OFF;
            PRAGMA threads = 4;
        """)
        conn.row_factory = sqlite3.Row
    except BaseException:
        conn.close()
        raise
    if not read_only:
        secure_db_permissions()
        try:
            st_after = os.stat(real_db_path)
            _VALIDATED_DB_FILES.add((real_db_path, st_after.st_dev, st_after.st_ino, False))
        except OSError:
            pass
    return conn

def backup_db(src_conn: sqlite3.Connection, dest_path: str, pages: int = -1) -> int:
    """Create an Optane-tuned atomic single-file SQLite backup to preserve database state and return the backed-up observation count, preventing torn reads or unverified backup snapshots."""
    old_umask = os.umask(0o077)
    dst = None
    try:
        dst = sqlite3.connect(dest_path)
        dst.execute("PRAGMA page_size = 4096;")
        dst.execute("PRAGMA cache_size = -65536;")
        dst.execute("PRAGMA mmap_size = 268435456;")
        dst.execute("PRAGMA temp_store = MEMORY;")
        src_conn.backup(dst, pages=pages)
        dst.execute("PRAGMA journal_mode = DELETE;")
        qc = dst.execute("PRAGMA quick_check;").fetchall()
        if not qc or qc[0][0] != "ok":
            raise RuntimeError(f"Backup verification failed: {qc}")
    finally:
        if dst is not None:
            dst.close()
        os.umask(old_umask)
        if os.path.exists(dest_path):
            try:
                os.chmod(dest_path, 0o600)
            except OSError:
                pass
        for suffix in ("-wal", "-shm", "-journal"):
            side = dest_path + suffix
            if os.path.exists(side):
                try:
                    os.unlink(side)
                except OSError:
                    pass
    try:
        return src_conn.execute("SELECT COUNT(*) FROM observations").fetchone()[0]
    except sqlite3.OperationalError:
        return 0

def _schema_missing(conn: sqlite3.Connection) -> frozenset[tuple[str, str]]:
    """Returns the set of required tables, indexes, and triggers missing from `conn` to verify schema completeness, preventing runtime SQL errors during search or recall."""
    rows = conn.execute("SELECT type, name FROM sqlite_master;").fetchall()
    present = {(r[0], r[1]) for r in rows}
    return _REQUIRED_SCHEMA_OBJECTS - present

_TABLE_COUNT_SQL = {
    "entities": "SELECT COUNT(*) FROM entities;",
    "observations": "SELECT COUNT(*) FROM observations;",
    "relations": "SELECT COUNT(*) FROM relations;",
}

def _count_table_rows(conn: sqlite3.Connection, table: str) -> int:
    """Executes a static row-count query for a known core table name to inspect table cardinality, preventing dynamic SQL string interpolation on table names."""
    return int(conn.execute(_TABLE_COUNT_SQL[table]).fetchone()[0])

def _backup_before_migration(conn: sqlite3.Connection, fmt: int) -> str | None:
    """Copies a non-empty legacy database aside with mode 0600 before schema migration rewrites it to preserve a rollback snapshot, preventing irreversible data loss on interrupted upgrades."""
    path = _db_file(conn)
    if not path:
        return None
    tables = {r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table';").fetchall()}
    rows = sum(_count_table_rows(conn, t) for t in CORE_TABLES if t in tables)
    if rows == 0:
        return None
    stamp = time.strftime("%Y%m%d-%H%M%S")
    for n in range(100):
        dest = f"{path}.pre-format{SCHEMA_VERSION}-from{fmt}-{stamp}{'' if n == 0 else f'-{n}'}.bak"
        try:
            fd = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0), 0o600)
        except FileExistsError:
            continue
        os.close(fd)
        src = None
        try:
            src = sqlite3.connect(path, timeout=5.0)
            src.execute("PRAGMA query_only = ON;")
            backup_db(src, dest)
        except BaseException:
            if src is not None:
                src.close()
            src = None
            for suffix in ("", "-wal", "-shm", "-journal"):
                try:
                    os.unlink(dest + suffix)
                except FileNotFoundError:
                    pass
            raise
        finally:
            if src is not None:
                src.close()
        return dest
    raise RuntimeError("Could not create a unique pre-migration backup file.")

def _backup_before_restore(conn: sqlite3.Connection) -> str | None:
    """Copies an existing non-empty live database aside with mode 0600 before restore replaces it to preserve a rollback snapshot, preventing irreversible data loss from accidental restores."""
    path = _db_file(conn)
    if not path or not os.path.exists(path):
        return None
    tables = {r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table';").fetchall()}
    rows = sum(_count_table_rows(conn, t) for t in CORE_TABLES if t in tables)
    if rows == 0:
        return None
    stamp = time.strftime("%Y%m%d-%H%M%S")
    for n in range(100):
        dest = f"{path}.pre-restore-{stamp}{'' if n == 0 else f'-{n}'}.bak"
        try:
            fd = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0), 0o600)
        except FileExistsError:
            continue
        os.close(fd)
        src = None
        try:
            src = sqlite3.connect(path, timeout=5.0)
            src.execute("PRAGMA query_only = ON;")
            backup_db(src, dest)
        except BaseException:
            if src is not None:
                src.close()
            src = None
            for suffix in ("", "-wal", "-shm", "-journal"):
                try:
                    os.unlink(dest + suffix)
                except FileNotFoundError:
                    pass
            raise
        finally:
            if src is not None:
                src.close()
        return dest
    raise RuntimeError("Could not create a unique pre-restore backup file.")

def _rebuild_canonical(conn: sqlite3.Connection) -> dict[str, int]:
    """Rebuild entities, observations, and relations into the canonical current layout within the caller's write transaction to complete schema migration, preventing legacy schema drift or orphaned foreign keys."""
    for (name,) in conn.execute("SELECT name FROM sqlite_master WHERE type='trigger';").fetchall():
        escaped_name = name.replace('"', '""')
        conn.execute(f'DROP TRIGGER IF EXISTS "{escaped_name}";')
    for (name,) in conn.execute("SELECT name FROM sqlite_master WHERE type='index' AND sql IS NOT NULL "
                                "AND tbl_name IN ('entities', 'observations', 'relations');").fetchall():
        escaped_name = name.replace('"', '""')
        conn.execute(f'DROP INDEX IF EXISTS "{escaped_name}";')
    conn.execute("DROP TABLE IF EXISTS observations_fts;")
    tables = {r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table';").fetchall()}
    before = {}
    for t in CORE_TABLES:
        conn.execute(f"DROP TABLE IF EXISTS {t}_legacy;")
        if t in tables:
            before[t] = _count_table_rows(conn, t)
            conn.execute(f"ALTER TABLE {t} RENAME TO {t}_legacy;")
    for stmt in TABLE_STATEMENTS:
        conn.execute(stmt)

    def cols(t: str) -> set[str]:
        """Queries `PRAGMA table_info` for a legacy table to return available column names, preventing schema rebuild queries from referencing non-existent columns."""
        return {r[1] for r in conn.execute(f"PRAGMA table_info({t});").fetchall()}

    def pick(available: set[str], name: str, fallback: str) -> str:
        """Selects an existing column name or a SQL fallback expression to construct migration queries, preventing SQLite `no such column` errors during schema upgrades."""
        return name if name in available else fallback

    def json_obj(c: str) -> str:
        """Builds a SQL `CASE` expression that wraps non-object JSON values into `json_object('legacy_value', ...)` to satisfy strict JSON object CHECK constraints without dropping legacy attributes."""
        return (f"CASE WHEN {c} IS NULL THEN NULL WHEN json_valid({c}) = 1 AND json_type({c}) = 'object' AND length({c}) <= 4000 "
                f"THEN {c} WHEN length(json_object('legacy_value', {c})) <= 4000 THEN json_object('legacy_value', {c}) ELSE NULL END")

    if "entities" in before:
        ec = cols("entities_legacy")
        etype = pick(ec, "type", "'concept'")
        ent_sql = " ".join((
            "INSERT OR IGNORE INTO entities (entity_id, name, type, summary, attributes, created_at, updated_at)",
            "SELECT entity_id, trim(name),",
            f"CASE WHEN lower({etype}) IN ('service', 'repo', 'pattern', 'concept', 'operator', 'host') THEN lower({etype}) ELSE 'concept' END,",
            f"{pick(ec, 'summary', 'NULL')},",
            f"{json_obj(pick(ec, 'attributes', 'NULL'))},",
            f"COALESCE({pick(ec, 'created_at', 'NULL')}, CURRENT_TIMESTAMP),",
            f"COALESCE({pick(ec, 'updated_at', 'NULL')}, CURRENT_TIMESTAMP)",
            "FROM entities_legacy",
            "WHERE entity_id IS NOT NULL AND name IS NOT NULL AND trim(name) != ''",
            "ORDER BY rowid;",
        ))
        conn.execute(ent_sql)

        # Remap legacy entity IDs to their surviving canonical entity ID (matching NOCASE name)
        conn.execute("DROP TABLE IF EXISTS _entity_remap;")
        conn.execute("""
            CREATE TEMP TABLE _entity_remap AS
            SELECT el.entity_id AS old_id, e.entity_id AS new_id, e.name AS new_name
            FROM entities_legacy el
            JOIN entities e ON lower(trim(el.name)) = lower(e.name)
            WHERE el.entity_id IS NOT NULL;
        """)

    detached = 0
    if "observations" in before:
        oc = cols("observations_legacy")

        def opick(name: str, fallback: str) -> str:
            """Selects a table-qualified `o.<column>` expression or a fallback literal for `observations_legacy` to construct migration SQL without column-resolution ambiguity."""
            return f"o.{name}" if name in oc else fallback

        cat = opick("category", "'architecture'")
        conf = opick("confidence", "1.0")
        tags = opick("tags", "NULL")
        legacy_name = opick("entity_name", "NULL")
        has_remap = bool(conn.execute("SELECT 1 FROM sqlite_temp_master WHERE type='table' AND name='_entity_remap';").fetchone())
        if has_remap:
            obs_remap_sql = " ".join((
                "INSERT OR IGNORE INTO observations (seq, observation_id, entity_id, entity_name, session_id, category, content, tags, confidence, created_at)",
                "SELECT o.rowid, o.observation_id,",
                "COALESCE(m.new_id, e.entity_id),",
                f"CASE WHEN COALESCE(m.new_id, e.entity_id) IS NOT NULL THEN COALESCE(m.new_name, e.name, {legacy_name}) ELSE NULL END,",
                f"COALESCE(NULLIF(trim({opick('session_id', 'NULL')}), ''), 'default'),",
                f"CASE WHEN lower({cat}) IN ('architecture', 'decision', 'invariant', 'preference', 'debug_finding') THEN lower({cat}) ELSE 'architecture' END,",
                "o.content,",
                f"CASE WHEN {tags} IS NULL OR trim({tags}) = '' THEN NULL WHEN json_valid({tags}) = 1 AND json_type({tags}) = 'array' THEN {tags} ELSE json_array({tags}) END,",
                f"CASE WHEN typeof({conf}) IN ('integer', 'real') THEN min(max({conf}, 0.0), 1.0) ELSE 1.0 END,",
                f"COALESCE({opick('created_at', 'NULL')}, CURRENT_TIMESTAMP)",
                "FROM observations_legacy o",
                "LEFT JOIN _entity_remap m ON m.old_id = o.entity_id",
                "LEFT JOIN entities e ON e.entity_id = o.entity_id",
                "WHERE o.observation_id IS NOT NULL AND o.content IS NOT NULL",
                "ORDER BY o.rowid;",
            ))
            conn.execute(obs_remap_sql)
            detached = conn.execute("""
                SELECT COUNT(*) FROM observations_legacy o
                WHERE o.entity_id IS NOT NULL
                  AND o.entity_id NOT IN (SELECT old_id FROM _entity_remap WHERE old_id IS NOT NULL)
                  AND o.entity_id NOT IN (SELECT entity_id FROM entities);
            """).fetchone()[0]
        else:
            obs_direct_sql = " ".join((
                "INSERT OR IGNORE INTO observations (seq, observation_id, entity_id, entity_name, session_id, category, content, tags, confidence, created_at)",
                "SELECT o.rowid, o.observation_id,",
                "e.entity_id,",
                f"CASE WHEN e.entity_id IS NOT NULL THEN COALESCE(e.name, {legacy_name}) ELSE NULL END,",
                f"COALESCE(NULLIF(trim({opick('session_id', 'NULL')}), ''), 'default'),",
                f"CASE WHEN lower({cat}) IN ('architecture', 'decision', 'invariant', 'preference', 'debug_finding') THEN lower({cat}) ELSE 'architecture' END,",
                "o.content,",
                f"CASE WHEN {tags} IS NULL OR trim({tags}) = '' THEN NULL WHEN json_valid({tags}) = 1 AND json_type({tags}) = 'array' THEN {tags} ELSE json_array({tags}) END,",
                f"CASE WHEN typeof({conf}) IN ('integer', 'real') THEN min(max({conf}, 0.0), 1.0) ELSE 1.0 END,",
                f"COALESCE({opick('created_at', 'NULL')}, CURRENT_TIMESTAMP)",
                "FROM observations_legacy o",
                "LEFT JOIN entities e ON e.entity_id = o.entity_id",
                "WHERE o.observation_id IS NOT NULL AND o.content IS NOT NULL",
                "ORDER BY o.rowid;",
            ))
            conn.execute(obs_direct_sql)
            detached = conn.execute("""
                SELECT COUNT(*) FROM observations_legacy o
                WHERE o.entity_id IS NOT NULL
                  AND o.entity_id NOT IN (SELECT entity_id FROM entities);
            """).fetchone()[0]
        # Tags written by older builds were ASCII-escaped JSON (\uXXXX), which FTS5 cannot match.
        for seq, tag_json in conn.execute("SELECT seq, tags FROM observations WHERE tags LIKE '%\\u%';").fetchall():
            try:
                conn.execute("UPDATE observations SET tags = ? WHERE seq = ?;",
                             (json.dumps(json.loads(tag_json), ensure_ascii=False), seq))
            except ValueError:
                pass
    if "relations" in before:
        rc = cols("relations_legacy")
        w = pick(rc, "weight", "1.0")
        has_remap = bool(conn.execute("SELECT 1 FROM sqlite_temp_master WHERE type='table' AND name='_entity_remap';").fetchone())
        src_id_col = "COALESCE(sm.new_id, r.source_entity_id)" if has_remap else "r.source_entity_id"
        tgt_id_col = "COALESCE(tm.new_id, r.target_entity_id)" if has_remap else "r.target_entity_id"
        join_clause = "LEFT JOIN _entity_remap sm ON sm.old_id = r.source_entity_id LEFT JOIN _entity_remap tm ON tm.old_id = r.target_entity_id" if has_remap else ""
        rel_sql = " ".join((
            "INSERT OR IGNORE INTO relations (relation_id, source_entity_id, target_entity_id, relation_type, weight, metadata, created_at, updated_at)",
            f"SELECT r.relation_id, {src_id_col}, {tgt_id_col}, lower(trim(r.relation_type)),",
            f"CASE WHEN typeof({w}) IN ('integer', 'real') THEN min(max({w}, 0.0), 100.0) ELSE 1.0 END,",
            f"{json_obj(pick(rc, 'metadata', 'NULL'))},",
            f"COALESCE({pick(rc, 'created_at', 'NULL')}, CURRENT_TIMESTAMP),",
            f"COALESCE({pick(rc, 'updated_at', 'NULL')}, CURRENT_TIMESTAMP)",
            "FROM relations_legacy r",
            join_clause,
            "WHERE r.relation_id IS NOT NULL AND r.relation_type IS NOT NULL AND trim(r.relation_type) != ''",
            f"AND {src_id_col} != {tgt_id_col}",
            f"AND {src_id_col} IN",
            "(SELECT entity_id FROM entities)",
            f"AND {tgt_id_col} IN",
            "(SELECT entity_id FROM entities)",
            "ORDER BY r.rowid;",
        ))
        conn.execute(rel_sql)
    dropped = {}
    for t in CORE_TABLES:
        if t in before:
            after = _count_table_rows(conn, t)
            if after < before[t]:
                dropped[t] = before[t] - after
    if "observations" in before and detached > 0:
        dropped["detached_observations"] = detached
    conn.execute("DROP TABLE IF EXISTS _entity_remap;")
    for t in ("relations", "observations", "entities"):
        conn.execute(f"DROP TABLE IF EXISTS {t}_legacy;")
    for stmt in FTS_STATEMENTS:
        conn.execute(stmt)
    conn.execute("INSERT INTO observations_fts(observations_fts) VALUES('rebuild');")
    try:
        conn.execute("INSERT INTO observations_fts(observations_fts, rank) VALUES('secure-delete', 1);")
    except sqlite3.OperationalError:
        pass
    return dropped

class _Transaction:
    """Enforces deterministic BEGIN/COMMIT/ROLLBACK boundaries for SQLite connections with `isolation_level=None` to guarantee atomic writes, preventing unhandled exceptions from leaving open transactions or partial state."""
    __slots__ = ("conn", "mode")

    def __init__(self, conn: sqlite3.Connection, mode: str = "IMMEDIATE"):
        """Stores the SQLite connection and transaction lock mode (`IMMEDIATE` or `DEFERRED`) to configure context-managed transaction execution without implicit autocommit ambiguity."""
        self.conn = conn
        self.mode = mode

    def __enter__(self):
        """Executes `BEGIN <mode>` on the underlying SQLite connection to start an explicit transaction boundary, preventing concurrent writers from interleaving statements."""
        self.conn.execute(f"BEGIN {self.mode};")
        return self.conn

    def __exit__(self, exc_type, exc_val, exc_tb):
        """Commits the active SQLite transaction on normal exit or rolls back on exception to preserve ACID consistency, preventing partial writes from persisting after an error."""
        if exc_type is None:
            try:
                self.conn.execute("COMMIT;")
            except sqlite3.Error:
                try:
                    self.conn.execute("ROLLBACK;")
                except sqlite3.Error:
                    pass
                raise
        else:
            try:
                self.conn.execute("ROLLBACK;")
            except sqlite3.Error:
                pass
        return False

def init_db(force: bool = False, conn: sqlite3.Connection | None = None, silent_migration_log: bool = False):
    """Create, verify, repair, or migrate the SQLite database to the current storage format, preventing unindexed FTS5 tables or incompatible schema access."""
    should_close = conn is None
    if conn is None:
        db_file = DB_PATH
        real_db_file = os.path.realpath(db_file)
        if os.path.isdir(real_db_file) or real_db_file in (_OPTANE_BASE_REAL, _AUTH_BASE_REAL):
            raise RuntimeError(f"Database path '{real_db_file}' cannot be a directory. Specify a database file.")
        if force and os.path.exists(db_file) and os.path.getsize(db_file) > 0:
            _check_not_guarded_path(_RAW_DB_PATH, "Database path")
            _check_not_guarded_path(db_file, "Database path")
            enforce_storage_gate(real_db_file, read_only=False, label="Database path")
            if os.path.lexists(_RAW_DB_PATH):
                _require_owned(_RAW_DB_PATH, "Database file", forbid_group_other_write=True, check_sidecars=True)
            _require_owned(db_file, "Database file", forbid_group_other_write=True, check_sidecars=True)
            if not _has_sqlite_header(real_db_file):
                raise RuntimeError(f"'{real_db_file}' is not an agent-memory SQLite database (unrecognised file header). Refusing to use or modify it.")
            is_corrupt = False
            try:
                tconn = sqlite3.connect(f"file:{_pathname2url(real_db_file)}?mode=ro", uri=True, timeout=5.0)
                try:
                    tconn.execute("PRAGMA busy_timeout = 5000;")
                    ident_chk = _db_identity(tconn)
                    err_chk = _identity_error(ident_chk, real_db_file)
                    if err_chk:
                        raise RuntimeError(err_chk)
                    qc = tconn.execute("PRAGMA quick_check(1);").fetchone()
                    if not qc or qc[0] != "ok":
                        is_corrupt = True
                finally:
                    tconn.close()
            except RuntimeError:
                raise
            except sqlite3.OperationalError as op_err:
                err_low = str(op_err).lower()
                if "locked" in err_low or "busy" in err_low:
                    raise RuntimeError(f"Database '{real_db_file}' is currently locked by another process: {op_err}") from op_err
                is_corrupt = True
            except (sqlite3.DatabaseError, OSError):
                is_corrupt = True

            if is_corrupt:
                stamp = time.strftime("%Y%m%d-%H%M%S")
                corrupt_bak = f"{db_file}.corrupt-{stamp}.bak"
                os.replace(db_file, corrupt_bak)
                _VALIDATED_DB_FILES.clear()
                try:
                    os.chmod(corrupt_bak, 0o600)
                except OSError:
                    pass
                for ext in ("-wal", "-shm", "-journal"):
                    side = db_file + ext
                    if os.path.exists(side):
                        try:
                            os.replace(side, f"{corrupt_bak}{ext}")
                            os.chmod(f"{corrupt_bak}{ext}", 0o600)
                        except OSError:
                            pass
                print(f"agent-memory: quarantined corrupted database to {corrupt_bak}, re-initializing clean schema", file=sys.stderr)
        conn = get_connection()
    else:
        conn.execute("PRAGMA foreign_keys = ON;")
        conn.execute("PRAGMA recursive_triggers = ON;")
    try:
        if conn.row_factory is None:
            conn.row_factory = sqlite3.Row
        db_label = _db_file(conn) or DB_PATH
        ident = _db_identity(conn)
        err = _identity_error(ident, db_label)
        if err:
            raise RuntimeError(err)
        fts_drift = False
        if ident["kind"] == "current" and not force and not _schema_missing(conn):
            try:
                with _Transaction(conn, "DEFERRED"):
                    indexed = conn.execute("SELECT COUNT(*) FROM observations_fts_docsize;").fetchone()[0]
                    obs_count = conn.execute("SELECT COUNT(*) FROM observations;").fetchone()[0]
                if indexed != obs_count:
                    fts_drift = True
            except sqlite3.OperationalError:
                fts_drift = True
            if not fts_drift:
                secure_db_permissions()
                return

        backup_path, dropped = None, {}
        if ident["kind"] == "legacy":
            backup_path = _backup_before_migration(conn, ident["format"])
        conn.execute("PRAGMA foreign_keys = OFF;")
        try:
            with _Transaction(conn, "IMMEDIATE"):
                ident = _db_identity(conn)
                err = _identity_error(ident, db_label)
                if err:
                    raise RuntimeError(err)
                missing = _schema_missing(conn)
                if ident["kind"] == "empty":
                    for stmt in SCHEMA_STATEMENTS:
                        conn.execute(stmt)
                    try:
                        conn.execute("INSERT INTO observations_fts(observations_fts, rank) VALUES('secure-delete', 1);")
                    except sqlite3.OperationalError:
                        pass
                elif ident["kind"] == "current" and not force:
                    if missing:
                        for stmt in SCHEMA_STATEMENTS:
                            conn.execute(stmt)
                    if fts_drift or (missing and any(kind in ("table", "trigger") for kind, _ in missing)):
                        conn.execute("INSERT INTO observations_fts(observations_fts) VALUES('rebuild');")
                    try:
                        conn.execute("INSERT INTO observations_fts(observations_fts, rank) VALUES('secure-delete', 1);")
                    except sqlite3.OperationalError:
                        pass
                else:
                    if ident["kind"] == "legacy" and not backup_path:
                        backup_path = _backup_before_migration(conn, ident["format"])
                    dropped = _rebuild_canonical(conn)
                conn.execute(f"PRAGMA application_id = {APP_ID};")
                conn.execute(f"PRAGMA user_version = {SCHEMA_VERSION};")
                fk_violations = conn.execute("PRAGMA foreign_key_check;").fetchall()
                if fk_violations:
                    raise RuntimeError(f"Foreign key violations after schema initialisation: {[tuple(r) for r in fk_violations[:5]]}")
        finally:
            conn.execute("PRAGMA foreign_keys = ON;")
        if backup_path and not silent_migration_log:
            print(f"agent-memory: migrated storage format {ident['format']} -> {SCHEMA_VERSION}. "
                  f"Backup of the previous database: {backup_path}", file=sys.stderr)
        if dropped and not silent_migration_log:
            print(f"agent-memory: warning: rows that could not be represented in format {SCHEMA_VERSION} were not "
                  f"carried over: {dropped} (they remain in the backup)", file=sys.stderr)
        secure_db_permissions()
    finally:
        if should_close:
            conn.close()

def row_to_dict(cur, row) -> dict[str, Any] | None:
    """Converts a SQLite row, tuple, or mapping into a standard Python dictionary to normalize query rows, preventing heterogeneous cursor row factories from causing key lookup errors."""
    if row is None:
        return None
    if isinstance(row, sqlite3.Row):
        return dict(row)
    if isinstance(row, dict):
        return row
    if cur and cur.description:
        return {col[0]: row[i] for i, col in enumerate(cur.description)}
    if isinstance(row, (list, tuple)):
        return {f"col_{i}": val for i, val in enumerate(row)}
    try:
        return dict(row)
    except (TypeError, ValueError):
        return {"raw": str(row)}

_FTS_COL_SPACE_RE = re.compile(r'(?i)\b(content|tags|entity_name):\s+(?="|\S)')
_FTS_TOKEN_RE = re.compile(r'[-+]?[a-zA-Z_]+:"(?:""|[^"])*"|[-+]?"(?:""|[^"])*"|-\(|\+\(|[()]|\bAND\b|\bOR\b|\bNOT\b|[^\s()]+')
_TRIM_EDGE_PUNCT_RE = re.compile(r"^(?:[^\w]|_)+|(?:[^\w]|_)+$")
_WORD_RE = re.compile(r"[^\W_]+")

_TOK_LPAREN = ("LPAREN", "(")
_TOK_RPAREN = ("RPAREN", ")")
_TOK_NOT = ("OP", "NOT")
_TOK_AND = ("OP", "AND")
_TOK_OR = ("OP", "OR")
_VALID_FTS_COLS = ("content", "tags", "entity_name")
_SANITIZE_CACHE: dict[str, str] = {}

def _cache_put(cache: dict, key, val, max_size: int = 512):
    """Inserts a key-value pair into a bounded FIFO dictionary cache and evicts the oldest entry on saturation to bound memory usage, preventing unbounded query caches from leaking memory in long-running MCP servers."""
    if len(cache) >= max_size:
        try:
            cache.pop(next(iter(cache)))
        except (KeyError, StopIteration):
            pass
    cache[key] = val

def _parse_fts_tree(tokens: list) -> list:
    """Parses flat classified FTS5 tokens into a bounded-depth nested group tree to structure boolean expressions, preventing unbalanced parentheses or deep nesting from triggering SQLite FTS5 parser errors."""
    root: list = []
    stack: list[list] = [root]
    for kind, val in tokens:
        if kind == "LPAREN":
            if len(stack) <= 32:
                grp: list = []
                stack[-1].append(("GROUP", grp))
                stack.append(grp)
        elif kind == "RPAREN":
            if len(stack) > 1:
                stack.pop()
        else:
            stack[-1].append((kind, val))
    return root

def _eval_fts_group(items: list) -> tuple[str, list[str]] | None:
    """Normalizes a parsed FTS5 token group into positive and negated clauses so unary NOT operators are rewritten into binary FTS5 NOT clauses, preventing SQLite FTS5 from rejecting leading unary NOT operators."""
    pos_clauses: list[tuple[str, list[str]]] = []
    neg_clauses: list[list[str]] = []
    negated = False
    pending_op = "AND"

    for kind, val in items:
        if kind == "OP":
            if val == "NOT":
                negated = not negated
            elif val in ("AND", "OR") and not negated:
                pending_op = val
            continue
        if kind == "TERM":
            if negated:
                neg_clauses.append([val])
                negated = False
                pending_op = "AND"
            else:
                pos_clauses.append((pending_op, [val]))
                pending_op = "AND"
        elif kind == "GROUP":
            sub = _eval_fts_group(val)
            if sub is None:
                negated = False
                continue
            sub_kind, sub_tokens = sub
            wrapped = ["("] + sub_tokens + [")"] if len(sub_tokens) > 1 else sub_tokens
            if negated:
                if sub_kind == "NEG":
                    pos_clauses.append((pending_op, wrapped))
                else:
                    neg_clauses.append(wrapped)
                negated = False
                pending_op = "AND"
            elif sub_kind == "NEG":
                neg_clauses.append(sub_tokens)
                pending_op = "AND"
            else:
                pos_clauses.append((pending_op, wrapped))
                pending_op = "AND"

    if not pos_clauses and not neg_clauses:
        return None

    if not pos_clauses:
        neg_tokens: list[str] = []
        for nc in neg_clauses:
            if neg_tokens:
                neg_tokens.append("OR")
            neg_tokens.extend(nc)
        if len(neg_clauses) > 1:
            neg_tokens = ["("] + neg_tokens + [")"]
        return ("NEG", neg_tokens)

    pos_tokens: list[str] = []
    has_or = False
    for idx, (op, toks) in enumerate(pos_clauses):
        if idx > 0:
            pos_tokens.append(op)
            if op == "OR":
                has_or = True
        pos_tokens.extend(toks)

    if not neg_clauses:
        return ("POS", pos_tokens)

    neg_tokens = []
    for nc in neg_clauses:
        if neg_tokens:
            neg_tokens.append("OR")
        neg_tokens.extend(nc)
    if len(neg_clauses) > 1:
        neg_tokens = ["("] + neg_tokens + [")"]
    if has_or or len(pos_clauses) > 1:
        pos_tokens = ["("] + pos_tokens + [")"]
    return ("POS", pos_tokens + ["NOT"] + neg_tokens)

def _should_prefix_expand(clean_term: str, had_wildcard: bool) -> bool:
    """Checks whether an unquoted FTS5 term has a trailing sub-token of at least 3 characters or an explicit wildcard to gate prefix expansion, preventing 1- or 2-character trailing sub-tokens from bypassing the prefix='3' FTS5 index."""
    if had_wildcard:
        return True
    subwords = _WORD_RE.findall(clean_term)
    return bool(subwords) and len(subwords[-1]) >= 3

def sanitize_fts_query(raw_query: str) -> str:
    """Sanitize search queries into valid FTS5 syntax to preserve boolean operators, column filters, and grouping semantics, preventing FTS5 syntax errors on special characters."""
    if not raw_query:
        return '""'
    cached = _SANITIZE_CACHE.get(raw_query)
    if cached is not None:
        return cached
    cleaned = _normalize_nfc(raw_query)
    cleaned = cleaned.replace("\x00", " ")
    cleaned = _FTS_COL_SPACE_RE.sub(r"\1:", cleaned)
    tokens = _FTS_TOKEN_RE.findall(cleaned)
    if not tokens:
        _cache_put(_SANITIZE_CACHE, raw_query, '""', 512)
        return '""'

    classified: list[tuple[str, str]] = []
    for lexeme in tokens:
        if lexeme == "-(":
            classified.append(_TOK_NOT)
            classified.append(_TOK_LPAREN)
        elif lexeme in ("(", "+("):
            classified.append(_TOK_LPAREN)
        elif lexeme == ")":
            classified.append(_TOK_RPAREN)
        elif lexeme == "NOT":
            classified.append(_TOK_NOT)
        elif lexeme == "AND":
            classified.append(_TOK_AND)
        elif lexeme == "OR":
            classified.append(_TOK_OR)
        elif lexeme in ("-", "+"):
            continue
        elif lexeme.startswith(('-"', '+"')) and lexeme.endswith('"') and len(lexeme) > 2:
            inner = lexeme[2:-1].replace('""', '"').replace('"', '""')
            if inner.strip() and any(c.isalnum() for c in inner):
                if lexeme.startswith("-"):
                    classified.append(_TOK_NOT)
                classified.append(("TERM", f'"{inner}"'))
            elif classified and classified[-1] == _TOK_NOT:
                classified.pop()
        elif lexeme.startswith('"') and lexeme.endswith('"'):
            inner = lexeme[1:-1].replace('""', '"').replace('"', '""')
            if inner.strip() and any(c.isalnum() for c in inner):
                classified.append(("TERM", f'"{inner}"'))
            elif classified and classified[-1] == _TOK_NOT:
                classified.pop()
        else:
            is_neg = False
            curr_token = lexeme
            if curr_token.startswith("-") and not curr_token.startswith("--") and len(curr_token) > 1:
                is_neg = True
                curr_token = curr_token[1:]
            elif curr_token.startswith("+") and not curr_token.startswith("++") and len(curr_token) > 1:
                curr_token = curr_token[1:]

            had_wildcard = curr_token.endswith("*")

            # Check for column filter e.g. entity_name:"web server" or entity_name:web01
            col_match = None
            if ":" in curr_token:
                for col in _VALID_FTS_COLS:
                    if curr_token.lower().startswith(col + ":") and len(curr_token) > len(col) + 1:
                        col_match = col
                        break
            if col_match:
                val_part = curr_token[len(col_match) + 1:]
                if col_match == "entity_name":
                    val_part = _normalize_nfkc(val_part)
                if val_part.startswith('"') and val_part.endswith('"'):
                    val_inner = val_part[1:-1].replace('""', '"').replace('"', '""')
                    if val_inner.strip() and any(c.isalnum() for c in val_inner):
                        if is_neg:
                            classified.append(_TOK_NOT)
                        classified.append(("TERM", f'{col_match} : "{val_inner}"'))
                    elif classified and classified[-1] == _TOK_NOT:
                        classified.pop()
                    continue
                val_clean = _TRIM_EDGE_PUNCT_RE.sub("", val_part).replace('"', '""')
                if val_clean and any(c.isalnum() for c in val_clean):
                    if is_neg:
                        classified.append(_TOK_NOT)
                    if _should_prefix_expand(val_clean, had_wildcard):
                        classified.append(("TERM", f'{col_match} : "{val_clean}"*'))
                    else:
                        classified.append(("TERM", f'{col_match} : "{val_clean}"'))
                elif classified and classified[-1] == _TOK_NOT:
                    classified.pop()
                continue

            safe_token = curr_token.replace('"', '""')
            clean_term = _TRIM_EDGE_PUNCT_RE.sub("", safe_token)
            if clean_term and any(c.isalnum() for c in clean_term):
                if is_neg:
                    classified.append(_TOK_NOT)
                if _should_prefix_expand(clean_term, had_wildcard):
                    classified.append(("TERM", f'"{clean_term}"*'))
                else:
                    classified.append(("TERM", f'"{clean_term}"'))
            elif classified and classified[-1] == _TOK_NOT:
                classified.pop()

    tree = _parse_fts_tree(classified)
    eval_res = _eval_fts_group(tree)
    if eval_res is None or eval_res[0] != "POS" or not eval_res[1]:
        _cache_put(_SANITIZE_CACHE, raw_query, '""', 512)
        return '""'

    result = " ".join(eval_res[1]).strip()
    out = result if result else '""'
    _cache_put(_SANITIZE_CACHE, raw_query, out, 512)
    return out

def split_tags_respecting_brackets(text: str) -> list[str]:
    """Splits comma-separated tag strings while respecting nested brackets and quotes to parse tag lists accurately, preventing naive comma splitting from fracturing generic type signatures such as Map<String, Int>."""
    if not text:
        return []
    if "," not in text:
        t = text.strip()
        return [t] if t else []
    if not any(c in text for c in ('<', '>', '[', ']', '(', ')', '{', '}', '"', "'", '\\')):
        return [t.strip() for t in text.split(',') if t.strip()]

    tokens = []
    current = []
    bracket_stack = []
    matching_open = {'>': '<', ']': '[', ')': '(', '}': '{'}
    in_quotes = False
    quote_char = None
    escaped = False

    i = 0
    n = len(text)
    while i < n:
        ch = text[i]
        if escaped:
            current.append(ch)
            escaped = False
            i += 1
            continue

        if ch == '\\':
            escaped = True
            current.append(ch)
            i += 1
            continue

        if ch in ('"', "'"):
            if not in_quotes:
                in_quotes = True
                quote_char = ch
            elif quote_char == ch:
                in_quotes = False
                quote_char = None
            current.append(ch)
        elif in_quotes:
            current.append(ch)
        elif ch in ('[', '(', '{'):
            bracket_stack.append(ch)
            current.append(ch)
        elif ch in (']', ')', '}'):
            if bracket_stack and bracket_stack[-1] == matching_open[ch]:
                bracket_stack.pop()
            current.append(ch)
        elif ch == '<':
            is_generic = True
            if i > 0 and text[i - 1].isspace() and i + 1 < n and (text[i + 1].isspace() or text[i + 1].isdigit() or text[i + 1] == '='):
                is_generic = False
            if is_generic:
                bracket_stack.append('<')
            current.append(ch)
        elif ch == '>':
            if bracket_stack and bracket_stack[-1] == '<':
                bracket_stack.pop()
            current.append(ch)
        elif ch == ',' and not bracket_stack:
            token = "".join(current).strip()
            if token:
                tokens.append(token)
            current = []
        else:
            current.append(ch)
        i += 1

    last_token = "".join(current).strip()
    if last_token:
        tokens.append(last_token)
    return tokens

_SECRET_PATTERNS = [
    (re.compile(r"-----BEGIN\s+(?:[A-Z0-9\s]+)?PRIVATE KEY(?:\s+BLOCK)?-----", re.IGNORECASE), "private key"),
    (re.compile(r"\b(?:PuTTY-User-Key-File-\d+|ssh-ed25519\s+AAAA[A-Za-z0-9+/=]+|ssh-rsa\s+AAAA[A-Za-z0-9+/=]{100,})"), "SSH key material"),
    (re.compile(r"\bAGE-SECRET-KEY-1[A-Z0-9]{58}\b", re.IGNORECASE), "age secret key"),
    (re.compile(r"\b(?:(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9_]{36,255}|github_pat_[A-Za-z0-9_]{22,255})\b"), "GitHub access token"),
    (re.compile(r"\bglpat-[A-Za-z0-9\-_]{20,}\b"), "GitLab personal access token"),
    (re.compile(r"\bsk-(?:proj-|ant-|live-|test-)?[A-Za-z0-9\-_]{20,}\b"), "API secret key"),
    (re.compile(r"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b"), "AWS access key ID"),
    (re.compile(r"(?i)(?:^|[^A-Za-z0-9])aws_secret_access_key['\"]?\s*[:=]\s*['\"]?[A-Za-z0-9/+=]{40}['\"]?"), "AWS secret access key"),
    (re.compile(r"\bAIza[0-9A-Za-z\-_]{35}\b"), "Google API key"),
    (re.compile(r"\bxox[baprs]-[0-9A-Za-z\-]{10,}\b"), "Slack token"),
    (re.compile(r"\b(?:pypi-AgEIcHlwaS5vcmc[A-Za-z0-9\-_]{50,}|hf_[A-Za-z0-9]{30,})\b"), "package registry token"),
    (re.compile(r"\beyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\b"), "JSON Web Token (JWT)"),
    (re.compile(r"[a-zA-Z][a-zA-Z0-9+.-]*://[^/\s:@]+:[^/\s:@]{4,}@[^\s/]+"), "URL basic-auth credentials"),
    (re.compile(r"https://(?:hooks\.slack\.com/services/T[A-Za-z0-9_]+/B[A-Za-z0-9_]+/[A-Za-z0-9_]+|(?:ptb\.|canary\.)?discord(?:app)?\.com/api/webhooks/\d+/[A-Za-z0-9_-]+)"), "webhook URL secret"),
    (re.compile(r"\bbearer\s+(?=[A-Za-z0-9\-._~+/=]*[0-9\-._~+/=])[A-Za-z0-9\-._~+/]{16,}=*(?=\s|$|['\",;)])", re.IGNORECASE), "bearer authentication token"),
    (re.compile(r"(?i)(?:^|[^A-Za-z0-9])(?:password|passwd|pwd|client_secret|api_secret|api_key|apikey|secret_key|api_token|bot_token|access_token|refresh_token|auth_token|private_token|session_token|private_key|encryption_key|signing_key|secret|token)['\"]?\s*[:=]\s*(?!(?:['\"]?(?:none|null|true|false|redacted|example|placeholder|changeme|\$[A-Za-z_][A-Za-z0-9_]*|<[^>]+>|\$\{[^}]+\})['\"]?)(?:\s|[,;}\])]|$))(?:'[^'\n]{8,}'|\"[^\"\n]{8,}\"|[^\s'\",;}]{8,})"), "credential assignment"),
]

_PERSONA_PROSE_RE = re.compile(
    r"(?i)(?:^\s*\*[^*\n]{4,}\*|\b(?:my\s+darling|my\s+love|dearest\s+darling)\b)",
    re.MULTILINE,
)

_JSON_C0_ESCAPE_RE = re.compile(
    r"(?<!\\)(?:\\\\)*\\u00(?:0[0-8bcef]|1[0-9a-f])",
    re.IGNORECASE,
)

def _collect_screen_strings(obj: Any) -> list[str]:
    """Recursively extracts string keys, string values, and key=value pairs from nested dictionaries or lists for pre-serialization secret and isolation screening."""
    out: list[str] = []
    if isinstance(obj, str):
        out.append(obj)
    elif isinstance(obj, dict):
        for k, v in obj.items():
            if isinstance(k, str):
                out.append(k)
            if isinstance(v, str):
                out.append(v)
                if isinstance(k, str):
                    out.append(f"{k}={v}")
            elif isinstance(v, (dict, list, tuple)):
                out.extend(_collect_screen_strings(v))
    elif isinstance(obj, (list, tuple)):
        for item in obj:
            out.extend(_collect_screen_strings(item))
    return out

def _screen_for_secrets(*values: str | None) -> str | None:
    """Scans input strings against `_SECRET_PATTERNS`, 7-bit ASCII bounds, and `_PERSONA_PROSE_RE` before database writes to block credentials, non-ASCII characters, and roleplay prose from being persisted in SQLite."""
    for val in values:
        if not val or not isinstance(val, str):
            continue
        if any(ord(ch) > 0x7E or (ord(ch) < 0x20 and ch not in ("\n", "\t")) for ch in val) or _JSON_C0_ESCAPE_RE.search(val):
            return "non-7-bit-ASCII character (Universal 7-Bit ASCII violation)"
        if _PERSONA_PROSE_RE.search(val):
            return "roleplay prose (Hard Isolation Rule violation)"
        for pat, name in _SECRET_PATTERNS:
            if pat.search(val):
                return name
    return None

def _parse_bounded_int(val: Any, label: str, lo: int = 1, hi: int = 100) -> tuple[int | None, str | None]:
    """Validates and converts an integer parameter within `[lo, hi]` while rejecting booleans and fractional floats, preventing silent float truncation or integer overflow."""
    if isinstance(val, (bool, float)):
        return None, f"{label} must be an integer between {lo} and {hi}."
    if isinstance(val, str):
        s = val.strip()
        if not s or (s[0] in "+-" and not s[1:].isdigit()) or (s[0] not in "+-" and not s.isdigit()):
            return None, f"{label} must be an integer between {lo} and {hi}."
    try:
        ival = int(val)
    except (ValueError, TypeError, OverflowError):
        return None, f"{label} must be an integer between {lo} and {hi}."
    if not (lo <= ival <= hi):
        return None, f"{label} must be between {lo} and {hi}."
    return ival, None

class _Abort(Exception):
    """Signals a controlled validation or lookup failure inside a write transaction to abort invalid mutations, preventing partial writes from committing before returning a structured error dictionary."""


def record_observation(content: str, entity_name: str | None = None, entity_type: str | None = "concept",
                       summary: str | None = None, category: str | None = "architecture", tags: Any = None,
                       confidence: float | None = 1.0, session_id: str | None = "default",
                       attributes: dict[str, Any] | str | None = None,
                       conn: sqlite3.Connection | None = None) -> dict[str, Any]:
    """Record an observation into SQLite and the FTS5 full-text index to persist architectural knowledge across agent sessions, preventing context loss or unindexed facts."""
    if not content or not isinstance(content, str):
        return {"error": "Content must be a non-empty string."}
    clean_content = _normalize_nfc(content).strip()
    if not clean_content:
        return {"error": "Content must be a non-empty string."}
    if len(clean_content) > MAX_CONTENT_CHARS:
        return {"error": f"Content is {len(clean_content)} characters, exceeding the limit of {MAX_CONTENT_CHARS}. Store one concise, self-contained fact."}

    conf_val = 1.0
    if confidence is not None:
        if isinstance(confidence, bool):
            return {"error": "Confidence must be a valid float between 0.0 and 1.0."}
        try:
            conf_val = float(confidence)
        except (ValueError, TypeError, OverflowError):
            return {"error": "Confidence must be a valid float between 0.0 and 1.0."}
        if not (0.0 <= conf_val <= 1.0):
            return {"error": "Confidence must be between 0.0 and 1.0."}

    if category is not None:
        if not isinstance(category, str):
            return {"error": f"Invalid category. Must be one of: {sorted(VALID_CATEGORIES)}"}
        clean_category = category.strip().lower()
        if clean_category not in VALID_CATEGORIES:
            return {"error": f"Invalid category '{clean_category}'. Must be one of: {sorted(VALID_CATEGORIES)}"}
    else:
        clean_category = "architecture"

    if entity_type is not None:
        if not isinstance(entity_type, str):
            return {"error": f"Invalid entity_type. Must be one of: {sorted(VALID_ENTITY_TYPES)}"}
        clean_entity_type = entity_type.strip().lower()
        if clean_entity_type not in VALID_ENTITY_TYPES:
            return {"error": f"Invalid entity_type '{clean_entity_type}'. Must be one of: {sorted(VALID_ENTITY_TYPES)}"}
    else:
        clean_entity_type = "concept"

    clean_name: str | None = None
    if entity_name is not None:
        if not isinstance(entity_name, str):
            return {"error": "Entity name must be a string."}
        clean_name = _normalize_nfkc(entity_name).strip()
        if not clean_name:
            return {"error": "Entity name cannot be empty."}
        if len(clean_name) > MAX_NAME_CHARS:
            return {"error": f"Entity name exceeds {MAX_NAME_CHARS} characters."}

    has_summary_arg = summary is not None
    clean_summary = None
    if summary is not None:
        if not isinstance(summary, str):
            return {"error": "Entity summary must be a string."}
        clean_summary = _normalize_nfc(summary).strip()
        if not clean_summary:
            clean_summary = None
        elif len(clean_summary) > MAX_SUMMARY_CHARS:
            return {"error": f"Entity summary exceeds {MAX_SUMMARY_CHARS} characters."}

    has_attr_arg = attributes is not None
    clean_attributes = None
    attr_dict_for_screen: dict[str, Any] | None = None
    if attributes is not None:
        if isinstance(attributes, str):
            try:
                parsed_attr = json.loads(attributes)
                if not isinstance(parsed_attr, dict):
                    return {"error": "Entity attributes must be a JSON object/dictionary."}
                attr_dict_for_screen = parsed_attr
                clean_attributes = json.dumps(parsed_attr, ensure_ascii=False, allow_nan=False)
            except (ValueError, TypeError) as e:
                return {"error": f"Entity attributes must be valid JSON (NaN/Infinity not allowed): {e}"}
        elif isinstance(attributes, dict):
            attr_dict_for_screen = attributes
            try:
                clean_attributes = json.dumps(attributes, ensure_ascii=False, allow_nan=False)
            except (TypeError, ValueError) as e:
                return {"error": f"Entity attributes could not be serialized to standard JSON (NaN/Infinity not allowed): {e}"}
        else:
            return {"error": "Entity attributes must be a dictionary or valid JSON string."}
        if len(clean_attributes) > MAX_ATTR_CHARS:
            return {"error": f"Entity attributes JSON exceeds {MAX_ATTR_CHARS} characters."}
        if clean_attributes == "{}":
            clean_attributes = None

    if not clean_name and (has_summary_arg or clean_entity_type != "concept" or has_attr_arg):
        return {"error": "Cannot specify entity summary, attributes, or non-default type without an entity name."}

    if session_id is not None and not isinstance(session_id, str):
        return {"error": "Session ID must be a string."}
    clean_session = ("default" if session_id is None else session_id).strip()
    if not clean_session:
        return {"error": "Session ID cannot be empty."}
    if len(clean_session) > MAX_SESSION_CHARS:
        return {"error": f"Session ID exceeds {MAX_SESSION_CHARS} characters."}

    raw_tag_items: list[Any] = []
    if tags is not None:
        if isinstance(tags, str):
            clean_s = tags.strip()
            if clean_s.startswith("[") and clean_s.endswith("]"):
                try:
                    parsed = json.loads(clean_s)
                    if isinstance(parsed, list):
                        raw_tag_items = parsed
                    else:
                        raw_tag_items = split_tags_respecting_brackets(tags)
                except ValueError:
                    raw_tag_items = split_tags_respecting_brackets(tags)
            else:
                raw_tag_items = split_tags_respecting_brackets(tags)
        elif isinstance(tags, list):
            raw_tag_items = tags
        else:
            return {"error": "Tags must be a list of strings or a comma-separated string."}

    tag_list = []
    seen_tags = set()
    for t in raw_tag_items:
        if not isinstance(t, str):
            return {"error": "All tags must be strings."}
        ts = _normalize_nfc(t).strip().strip('"\'').strip()
        if ts and ts.lower() not in seen_tags:
            if len(ts) > MAX_TAG_CHARS:
                return {"error": f"Tag exceeds {MAX_TAG_CHARS} characters (got {len(ts)})."}
            seen_tags.add(ts.lower())
            tag_list.append(ts)
    if len(tag_list) > MAX_TAGS:
        return {"error": f"Too many tags ({len(tag_list)}), exceeding the limit of {MAX_TAGS}."}

    tag_json = _EMPTY_TAGS_JSON if not tag_list else json.dumps(tag_list, separators=(',', ':'), ensure_ascii=False)

    # Secret hygiene screening across all user-supplied text fields prior to JSON escaping
    screen_targets: list[str | None] = [clean_content, clean_name, clean_summary, clean_session, *tag_list]
    if attr_dict_for_screen is not None:
        screen_targets.extend(_collect_screen_strings(attr_dict_for_screen))
    matched_rule = _screen_for_secrets(*screen_targets)
    if matched_rule:
        return {"error": f"Secret hygiene check failed: input contains {matched_rule}. Never record raw credentials, tokens, or private keys into memory."}

    should_close = False
    try:
        if conn is None:
            conn = get_connection()
            should_close = True
            try:
                uv_row = conn.execute("PRAGMA user_version;").fetchone()
                if not uv_row or uv_row[0] != SCHEMA_VERSION:
                    init_db(conn=conn)
                else:
                    conn.execute("SELECT 1 FROM observations LIMIT 1;")
            except sqlite3.OperationalError:
                init_db(conn=conn)

        # High-performance zero-write duplicate seek:
        if clean_name and clean_summary is None and clean_attributes is None:
            try:
                dup_row = conn.execute("""
                    SELECT o.observation_id, o.category, o.session_id, e.entity_id, e.name, e.type
                    FROM entities e
                    JOIN observations o ON e.entity_id = o.entity_id
                    WHERE e.name = ? COLLATE NOCASE AND o.content = ?
                    LIMIT 1;
                """, (clean_name, clean_content)).fetchone()
                if dup_row and clean_entity_type in ("concept", str(dup_row[5]).lower()):
                    return {"status": "exists", "observation_id": dup_row[0], "entity_id": dup_row[3],
                            "entity_name": dup_row[4], "category": dup_row[1], "session_id": dup_row[2]}
            except sqlite3.OperationalError:
                init_db(conn=conn)

        # Pre-lock UUID generation: execute outside the critical write-lock section
        new_id = _uuid4_str() if clean_name else None
        obs_id = _uuid4_str()

        with _Transaction(conn, "IMMEDIATE"):
            entity_id = None
            canonical_name = None
            if clean_name:
                if clean_attributes:
                    existing_attr_row = conn.execute(
                        "SELECT attributes FROM entities WHERE name = ? COLLATE NOCASE;",
                        (clean_name,),
                    ).fetchone()
                # Attributes follow RFC 7396 JSON Merge Patch semantics: keys are merged,
                # a key set to null is removed, and {} is a no-op (never a wipe).
                if clean_attributes and existing_attr_row and existing_attr_row[0]:
                    merged_len = conn.execute(
                        "SELECT CASE WHEN json_valid(?1) = 1 THEN length(json_patch(?1, ?2)) ELSE length(json_patch('{}', ?2)) END;",
                        (existing_attr_row[0], clean_attributes),
                    ).fetchone()[0]
                    if merged_len and merged_len > MAX_ATTR_CHARS:
                        raise _Abort(f"Entity attributes JSON exceeds {MAX_ATTR_CHARS} characters after merge.")
                if _HAS_RETURNING:
                    row = conn.execute("""
                        INSERT INTO entities (entity_id, name, type, summary, attributes, updated_at)
                        VALUES (?1, ?2, ?3, ?4, CASE WHEN ?5 IS NULL OR ?5 = '{}' THEN NULL ELSE json_patch('{}', ?5) END, CURRENT_TIMESTAMP)
                        ON CONFLICT(name) DO UPDATE SET
                            updated_at = CURRENT_TIMESTAMP,
                            type = CASE WHEN excluded.type != 'concept' THEN excluded.type ELSE type END,
                            summary = CASE WHEN excluded.summary IS NOT NULL THEN excluded.summary ELSE summary END,
                            attributes = CASE
                                WHEN ?5 IS NULL OR ?5 = '{}' THEN entities.attributes
                                WHEN entities.attributes IS NOT NULL AND json_valid(entities.attributes) = 1
                                    THEN json_patch(entities.attributes, ?5)
                                ELSE json_patch('{}', ?5)
                            END
                        RETURNING entity_id, name;
                    """, (new_id, clean_name, clean_entity_type, clean_summary, clean_attributes)).fetchone()
                    entity_id, canonical_name = row[0], row[1]
                else:
                    conn.execute("""
                        INSERT INTO entities (entity_id, name, type, summary, attributes, updated_at)
                        VALUES (?1, ?2, ?3, ?4, CASE WHEN ?5 IS NULL OR ?5 = '{}' THEN NULL ELSE json_patch('{}', ?5) END, CURRENT_TIMESTAMP)
                        ON CONFLICT(name) DO UPDATE SET
                            updated_at = CURRENT_TIMESTAMP,
                            type = CASE WHEN excluded.type != 'concept' THEN excluded.type ELSE type END,
                            summary = CASE WHEN excluded.summary IS NOT NULL THEN excluded.summary ELSE summary END,
                            attributes = CASE
                                WHEN ?5 IS NULL OR ?5 = '{}' THEN entities.attributes
                                WHEN entities.attributes IS NOT NULL AND json_valid(entities.attributes) = 1
                                    THEN json_patch(entities.attributes, ?5)
                                ELSE json_patch('{}', ?5)
                            END;
                    """, (new_id, clean_name, clean_entity_type, clean_summary, clean_attributes))
                    row = conn.execute("SELECT entity_id, name FROM entities WHERE name = ? COLLATE NOCASE;", (clean_name,)).fetchone()
                    entity_id, canonical_name = row[0], row[1]

            if _HAS_RETURNING:
                ins_cur = conn.execute("""
                    INSERT INTO observations (observation_id, entity_id, entity_name, session_id, category, content, tags, confidence)
                    SELECT ?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8
                    WHERE ?2 IS NULL OR NOT EXISTS (
                        SELECT 1 FROM observations WHERE entity_id = ?2 AND content = ?6
                    )
                    RETURNING observation_id;
                """, (obs_id, entity_id, canonical_name, clean_session, clean_category, clean_content,
                      tag_json, conf_val))
                ins_row = ins_cur.fetchone()
                if ins_row is None and entity_id is not None:
                    dup = conn.execute("SELECT observation_id, category, session_id FROM observations "
                                       "WHERE entity_id = ? AND content = ? LIMIT 1;", (entity_id, clean_content)).fetchone()
                    if dup:
                        return {"status": "exists", "observation_id": dup[0], "entity_id": entity_id,
                                "entity_name": canonical_name, "category": dup[1], "session_id": dup[2]}
            else:
                if entity_id:
                    dup = conn.execute("SELECT observation_id, category, session_id FROM observations "
                                       "WHERE entity_id = ? AND content = ? LIMIT 1;", (entity_id, clean_content)).fetchone()
                    if dup:
                        return {"status": "exists", "observation_id": dup[0], "entity_id": entity_id,
                                "entity_name": canonical_name, "category": dup[1], "session_id": dup[2]}
                conn.execute("""
                    INSERT INTO observations (observation_id, entity_id, entity_name, session_id, category, content, tags, confidence)
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?)
                """, (obs_id, entity_id, canonical_name, clean_session, clean_category, clean_content,
                      tag_json, conf_val))

        return {
            "status": "success",
            "observation_id": obs_id,
            "entity_id": entity_id,
            "entity_name": canonical_name if entity_id else None,
            "category": clean_category,
            "session_id": clean_session
        }
    except _Abort as e:
        return {"error": str(e)}
    except (sqlite3.Error, RuntimeError, OSError, ValueError, TypeError, ArithmeticError) as e:
        return {"error": f"Record observation failed: {e}"}
    finally:
        if should_close and conn is not None:
            try:
                conn.close()
            except sqlite3.Error:
                pass

def relate_entities(source_name: str, target_name: str, relation_type: str,
                    weight: float | None = None, metadata: dict[str, Any] | str | None = None,
                    conn: sqlite3.Connection | None = None) -> dict[str, Any]:
    """Create or update a directed graph edge between two entities in the knowledge graph to map component dependencies, preventing unlinked entity topology."""
    s_clean = _normalize_nfkc(source_name).strip() if isinstance(source_name, str) else ""
    t_clean = _normalize_nfkc(target_name).strip() if isinstance(target_name, str) else ""
    r_type = (relation_type or "").strip().lower() if isinstance(relation_type, str) else ""
    if not s_clean or not t_clean or not r_type:
        return {"error": "Source, target, and relation type cannot be empty."}
    if max(len(s_clean), len(t_clean), len(r_type)) > MAX_NAME_CHARS:
        return {"error": f"Entity names and relation types are limited to {MAX_NAME_CHARS} characters."}
    if nocase_key(s_clean) == nocase_key(t_clean):
        return {"error": "Cannot relate an entity to itself."}

    w_val = None
    if weight is not None:
        if isinstance(weight, bool):
            return {"error": "Weight must be a valid number."}
        try:
            w_val = float(weight)
        except (ValueError, TypeError, OverflowError):
            return {"error": "Weight must be a valid number."}
        if not (0.0 <= w_val <= 100.0):
            return {"error": "Weight must be between 0.0 and 100.0."}

    if metadata is not None:
        if isinstance(metadata, str):
            try:
                parsed = json.loads(metadata)
            except (ValueError, TypeError) as e:
                return {"error": f"Metadata must be valid JSON: {e}"}
            if not isinstance(parsed, dict):
                return {"error": "Metadata must be a JSON object (dictionary)."}
            metadata = parsed
        elif not isinstance(metadata, dict):
            return {"error": "Metadata must be a JSON object (dictionary)."}

    meta_json = None
    if metadata is not None:
        try:
            meta_json = json.dumps(metadata, ensure_ascii=False, allow_nan=False)
        except (TypeError, ValueError) as e:
            return {"error": f"Metadata could not be serialized to standard JSON (NaN/Infinity not allowed): {e}"}
        if len(meta_json) > MAX_ATTR_CHARS:
            return {"error": f"Relation metadata JSON exceeds {MAX_ATTR_CHARS} characters."}
        if meta_json == "{}":
            meta_json = None

    rel_screen_targets: list[str | None] = [s_clean, t_clean, r_type]
    if metadata is not None:
        rel_screen_targets.extend(_collect_screen_strings(metadata))
    matched_rule = _screen_for_secrets(*rel_screen_targets)
    if matched_rule:
        return {"error": f"Secret hygiene check failed: input contains {matched_rule}. Never record raw credentials, tokens, or private keys into memory."}

    should_close = False
    try:
        if conn is None:
            conn = get_connection()
            should_close = True
            try:
                uv_row = conn.execute("PRAGMA user_version;").fetchone()
                if not uv_row or uv_row[0] != SCHEMA_VERSION:
                    init_db(conn=conn)
                else:
                    conn.execute("SELECT 1 FROM relations LIMIT 1;")
            except sqlite3.OperationalError:
                init_db(conn=conn)

        rel_uuid = _uuid4_str()
        cur = conn.cursor()
        cur.row_factory = None
        try:
            with _Transaction(conn, "IMMEDIATE"):
                # Fast-path: query existing entities in a single SELECT without dirtying table pages or WAL
                found_rows = cur.execute(
                    "SELECT entity_id, name FROM entities WHERE name IN (?, ?) COLLATE NOCASE;",
                    (s_clean, t_clean)
                ).fetchall()

                if len(found_rows) == 2:
                    r0, r1 = found_rows[0], found_rows[1]
                    if nocase_key(r0[1]) == nocase_key(s_clean):
                        source_id, source_canonical = r0[0], r0[1]
                        target_id, target_canonical = r1[0], r1[1]
                    else:
                        source_id, source_canonical = r1[0], r1[1]
                        target_id, target_canonical = r0[0], r0[1]
                else:
                    found = {nocase_key(r[1]): (r[0], r[1]) for r in found_rows}

                    def resolve_or_create(name: str) -> tuple[str, str]:
                        """Resolves an existing entity by case-insensitive name or inserts a new `concept` entity to return `(entity_id, canonical_name)`, preventing broken foreign-key references when creating graph relations."""
                        k = nocase_key(name)
                        if k in found:
                            return found[k]
                        if _HAS_RETURNING:
                            row = cur.execute("""
                                INSERT INTO entities (entity_id, name, type, summary)
                                VALUES (?, ?, 'concept', NULL)
                                ON CONFLICT(name) DO UPDATE SET updated_at = CURRENT_TIMESTAMP
                                RETURNING entity_id, name;
                            """, (_uuid4_str(), name)).fetchone()
                            return row[0], row[1]
                        cur.execute("""
                            INSERT INTO entities (entity_id, name, type, summary)
                            VALUES (?, ?, 'concept', NULL)
                            ON CONFLICT(name) DO UPDATE SET updated_at = CURRENT_TIMESTAMP;
                        """, (_uuid4_str(), name))
                        row = cur.execute("SELECT entity_id, name FROM entities WHERE name = ? COLLATE NOCASE;", (name,)).fetchone()
                        return row[0], row[1]

                    source_id, source_canonical = resolve_or_create(s_clean)
                    target_id, target_canonical = resolve_or_create(t_clean)

                if source_id == target_id:
                    raise _Abort("Cannot relate an entity to itself.")

                if meta_json:
                    existing_meta_row = cur.execute(
                        "SELECT metadata FROM relations WHERE source_entity_id = ? AND target_entity_id = ? AND relation_type = ?;",
                        (source_id, target_id, r_type),
                    ).fetchone()
                    if existing_meta_row and existing_meta_row[0]:
                        merged_meta_len = cur.execute(
                            "SELECT length(json_patch(coalesce(nullif(?1, ''), '{}'), ?2));",
                            (existing_meta_row[0], meta_json),
                        ).fetchone()[0]
                        if merged_meta_len and merged_meta_len > MAX_ATTR_CHARS:
                            raise _Abort(f"Relation metadata JSON exceeds {MAX_ATTR_CHARS} characters after merge.")

                if _HAS_RETURNING:
                    actual_rel_id = cur.execute("""
                        INSERT INTO relations (relation_id, source_entity_id, target_entity_id, relation_type, weight, metadata, updated_at)
                        VALUES (?1, ?2, ?3, ?4, coalesce(?5, 1.0), CASE WHEN ?6 IS NULL OR ?6 = '{}' THEN '{}' ELSE json_patch('{}', ?6) END, CURRENT_TIMESTAMP)
                        ON CONFLICT(source_entity_id, target_entity_id, relation_type) DO UPDATE SET
                            weight = coalesce(?5, relations.weight),
                            metadata = CASE
                                WHEN ?6 IS NULL THEN relations.metadata
                                ELSE json_patch(coalesce(nullif(relations.metadata, ''), '{}'), ?6)
                            END,
                            updated_at = CURRENT_TIMESTAMP
                        RETURNING relation_id;
                    """, (rel_uuid, source_id, target_id, r_type, w_val, meta_json)).fetchone()[0]
                else:
                    cur.execute("""
                        INSERT INTO relations (relation_id, source_entity_id, target_entity_id, relation_type, weight, metadata, updated_at)
                        VALUES (?1, ?2, ?3, ?4, coalesce(?5, 1.0), CASE WHEN ?6 IS NULL OR ?6 = '{}' THEN '{}' ELSE json_patch('{}', ?6) END, CURRENT_TIMESTAMP)
                        ON CONFLICT(source_entity_id, target_entity_id, relation_type) DO UPDATE SET
                            weight = coalesce(?5, relations.weight),
                            metadata = CASE
                                WHEN ?6 IS NULL THEN relations.metadata
                                ELSE json_patch(coalesce(nullif(relations.metadata, ''), '{}'), ?6)
                            END,
                            updated_at = CURRENT_TIMESTAMP;
                    """, (rel_uuid, source_id, target_id, r_type, w_val, meta_json))
                    actual_rel_id = cur.execute(
                        "SELECT relation_id FROM relations WHERE source_entity_id = ? AND target_entity_id = ? AND relation_type = ?;",
                        (source_id, target_id, r_type)).fetchone()[0]
        finally:
            cur.close()

        return {
            "status": "success",
            "relation_id": actual_rel_id,
            "source": source_canonical,
            "target": target_canonical,
            "relation_type": r_type
        }
    except _Abort as e:
        return {"error": str(e)}
    except (sqlite3.Error, RuntimeError, OSError, ValueError, TypeError, ArithmeticError) as e:
        return {"error": f"Relate entities failed: {e}"}
    finally:
        if should_close and conn is not None:
            try:
                conn.close()
            except sqlite3.Error:
                pass

_STOPWORDS = frozenset((
    "a", "an", "and", "are", "as", "at", "be", "been", "but", "by", "can", "could", "did", "do",
    "does", "doing", "for", "from", "had", "has", "have", "how", "i", "if", "in", "into", "is", "it",
    "its", "me", "my", "no", "not", "of", "on", "or", "our", "should", "so", "than", "that", "the",
    "their", "them", "then", "there", "these", "they", "this", "to", "too", "was", "we", "were",
    "what", "when", "where", "which", "who", "why", "will", "with", "would", "you", "your",
))

_NON_PLAIN_RE = re.compile(r'["()*]|(?:^|\s)(?:-(?!-)|\+(?!\+))(?=\S)|(?i:\b(?:content|tags|entity_name|category):)|\b(?:AND|OR|NOT)\b')
_SPECIAL_SYNTAX_CHARS = ('"', '(', ')', ':', '-', '+', '*')

_PLAIN_QUERY_CACHE: dict[str, tuple[str, str | None] | None] = {}

def build_plain_fts_queries(text: str) -> tuple[str, str | None] | None:
    """Builds strict (AND) and relaxed (OR) FTS5 query clauses for plain natural-language search strings to support multi-word recall, preventing conversational phrasing from yielding zero matches."""
    if not text:
        return None
    cached = _PLAIN_QUERY_CACHE.get(text)
    if cached is not None or text in _PLAIN_QUERY_CACHE:
        return cached

    clean_text = _normalize_nfc(text)
    for c in _SPECIAL_SYNTAX_CHARS:
        if c in clean_text:
            if _NON_PLAIN_RE.search(clean_text):
                _cache_put(_PLAIN_QUERY_CACHE, text, None, 512)
                return None
            break
    else:
        if ("AND" in clean_text or "OR" in clean_text or "NOT" in clean_text) and _NON_PLAIN_RE.search(clean_text):
            _cache_put(_PLAIN_QUERY_CACHE, text, None, 512)
            return None

    words = _WORD_RE.findall(clean_text)
    if not words:
        _cache_put(_PLAIN_QUERY_CACHE, text, None, 512)
        return None
    terms, all_terms, seen = [], [], set()
    has_non_stop = False
    for w in words:
        lw = w.lower()
        if lw in seen:
            continue
        seen.add(lw)
        term = f'("{w}" OR "{w}"*)' if len(w) >= 3 else f'"{w}"'
        all_terms.append(term)
        if lw not in _STOPWORDS:
            terms.append(term)
            has_non_stop = True
    chosen = terms if has_non_stop else all_terms
    if not chosen:
        res = None
    else:
        res = (" AND ".join(chosen), (" OR ".join(chosen) if len(chosen) >= 2 else None))
    _cache_put(_PLAIN_QUERY_CACHE, text, res, 512)
    return res

_INLINE_CATEGORY_RE = re.compile(r'(?:(?<=[\s(])|^)(?:(NOT)\s+|([-+]?))category:\s*(?:"((?:""|[^"])*)"|([^\s()"]+))', re.IGNORECASE)
_OR_LEFT_RE = re.compile(r'\bOR\s*$', re.IGNORECASE)
_OR_RIGHT_RE = re.compile(r'^\s*\bOR\b', re.IGNORECASE)
_AND_LEFT_RE = re.compile(r'(?:^|\s+)\bAND\s*$', re.IGNORECASE)
_AND_RIGHT_RE = re.compile(r'^\s*\bAND\b(?:\s+|$)', re.IGNORECASE)

def _extract_inline_category(query: str) -> tuple[str, str | None, str | None]:
    """Extracts a top-level inline `category:` filter from a search query string to route category filtering to SQL WHERE clauses, preventing FTS5 MATCH errors on the UNINDEXED `category` column."""
    if "category:" not in query.lower():
        return query, None, None
    quoted = [m.span() for m in re.finditer(r'"(?:""|[^"])*"', query)]
    matches = [m for m in _INLINE_CATEGORY_RE.finditer(query)
               if not any(a < m.start() < b for a, b in quoted)]
    if not matches:
        return query, None, None
    if len(matches) > 1:
        return query, None, "Only one category: filter is allowed per query."
    m = matches[0]
    if m.group(1) or m.group(2) == "-":
        return query, None, "Excluding a category (-category: or NOT category:) is not supported. Pass the category you want instead."
    prefix = query[:m.start()]
    suffix = query[m.end():]
    paren_depth = 0
    for idx_ch, ch in enumerate(prefix):
        if any(a <= idx_ch < b for a, b in quoted):
            continue
        if ch == "(":
            paren_depth += 1
        elif ch == ")" and paren_depth > 0:
            paren_depth -= 1
    if paren_depth > 0 or _OR_LEFT_RE.search(prefix) or _OR_RIGHT_RE.search(suffix):
        return query, None, "Inline category: filter cannot be nested inside parentheses or combined with OR. Pass the category parameter instead."
    prefix = _AND_LEFT_RE.sub(" ", prefix)
    if not prefix.strip():
        suffix = _AND_RIGHT_RE.sub(" ", suffix)
    value = m.group(3).replace('""', '"') if m.group(3) is not None else m.group(4)
    return (prefix + suffix).strip(), value, None

_TAGS_CACHE: dict[str, list[str]] = {}

def _parse_cached_tags(s: str | list[str] | None) -> list[str]:
    """Deserializes a JSON tag array with bounded caching and returns a defensive list copy to accelerate row formatting, preventing repeated `json.loads` overhead and caller cache mutation."""
    if not s or s == "[]":
        return []
    if isinstance(s, list):
        return s.copy()
    cached = _TAGS_CACHE.get(s)
    if cached is not None:
        return cached.copy()
    try:
        val = json.loads(s)
        res = val if isinstance(val, list) else []
    except (ValueError, TypeError):
        res = []
    _cache_put(_TAGS_CACHE, s, res, 1024)
    return res.copy()

_META_CACHE: dict[str, dict[str, Any]] = {}

def _parse_cached_meta(raw: str | None) -> dict[str, Any]:
    """Deserializes a JSON attributes or metadata object with bounded caching and returns a deep copy to isolate cached objects, preventing callers from mutating cached entity state."""
    if not raw or raw == "{}" or raw == "null":
        return {}
    cached = _META_CACHE.get(raw)
    if cached is not None:
        return copy.deepcopy(cached)
    try:
        val = json.loads(raw)
        res = val if isinstance(val, dict) else {}
    except (ValueError, TypeError):
        res = {}
    _cache_put(_META_CACHE, raw, res, 1024)
    return copy.deepcopy(res)

def _result_row(r, match: str) -> dict[str, Any]:
    """Formats a raw SQLite search result tuple into a structured observation dictionary with BM25 rank and match mode to standardize search responses, preventing inconsistent row serialization from breaking MCP tool consumers."""
    if isinstance(r, (tuple, sqlite3.Row)):
        return {
            "observation_id": r[0],
            "session_id": r[1],
            "category": r[2],
            "content": r[3],
            "tags": _parse_cached_tags(r[4]),
            "confidence": float(r[5]),
            "created_at": r[6],
            "entity_name": r[7],
            "entity_type": r[8],
            "rank": float(r[9]),
            "match": match,
        }
    d = row_to_dict(None, r) or {}
    d["tags"] = _parse_cached_tags(d.get("tags"))
    d["confidence"] = float(d["confidence"])
    d["rank"] = float(d["rank"])
    d["match"] = match
    return d

def search_memory(query: str | None = None, category: str | None = None, session_id: str | None = None,
                  limit: int | None = 10, conn: sqlite3.Connection | None = None) -> list[dict[str, Any]] | dict[str, Any]:
    """Execute a full-text or category search across indexed observations using FTS5 and BM25 ranking to retrieve relevant historical facts, preventing duplicate or uncontextualized decisions."""
    if category is not None:
        if not isinstance(category, str):
            return {"error": "Category must be a string."}
        if not category.replace("\x00", " ").strip():
            return {"error": f"Invalid category ''. Must be one of: {sorted(VALID_CATEGORIES)}"}
    if query is not None and not isinstance(query, str):
        return {"error": "Query must be a string."}
    has_category = bool(category and category.strip())
    has_query = bool(query and query.strip())
    if not has_query and not has_category:
        return {"error": "Query must be a non-empty string or a category filter must be provided."}

    if limit is None:
        bounded_limit = 10
    else:
        parsed_lim, lim_err = _parse_bounded_int(limit, "Limit", 1, 100)
        if lim_err or parsed_lim is None:
            return {"error": lim_err or "Limit must be an integer between 1 and 100."}
        bounded_limit = parsed_lim

    if session_id is not None:
        if not isinstance(session_id, str):
            return {"error": "Session ID must be a string."}
        clean_sess = session_id.replace("\x00", " ").strip()
        if not clean_sess:
            return {"error": "Session ID cannot be empty."}
        if len(clean_sess) > MAX_SESSION_CHARS:
            return {"error": f"Session ID exceeds {MAX_SESSION_CHARS} characters."}
    else:
        clean_sess = None

    raw_q = query or ""
    clean_raw_query = _normalize_nfc(raw_q).replace("\x00", " ")
    if len(clean_raw_query) > MAX_QUERY_CHARS:
        return {"error": f"Search query is {len(clean_raw_query)} characters, exceeding the limit of {MAX_QUERY_CHARS}."}

    clean_raw_query, inline_category, cat_error = _extract_inline_category(clean_raw_query)
    if cat_error:
        return {"error": cat_error}
    clean_raw_query = clean_raw_query.strip()
    explicit_category = category.strip().lower() if (category and has_category) else None
    if inline_category is not None:
        inline_category = inline_category.strip().lower()
        if explicit_category and inline_category != explicit_category:
            return {"error": f"Conflicting categories: '{explicit_category}' (category parameter) and "
                             f"'{inline_category}' (inline category:)."}
    parsed_category = explicit_category or inline_category
    if parsed_category is not None and parsed_category not in VALID_CATEGORIES:
        return {"error": f"Invalid category '{parsed_category}'. Must be one of: {sorted(VALID_CATEGORIES)}"}

    if not clean_raw_query and not parsed_category:
        return {"error": "Query must be a non-empty string or a category filter must be provided."}

    plain = None
    safe_query = '""'
    if clean_raw_query:
        plain = build_plain_fts_queries(clean_raw_query)
        safe_query = plain[0] if plain else sanitize_fts_query(clean_raw_query)
        if safe_query == '""':
            return {"error": "Query has no positive search terms (a purely negative query such as '-nginx' cannot "
                             "be answered by full-text search). Add at least one term to look for, e.g. 'web -nginx', "
                             "or search by category alone."}

    should_close = False
    if conn is None:
        try:
            conn = get_connection(read_only=True)
        except FileNotFoundError:
            return {"error": f"No memory database at {DB_PATH}. Record something first or run 'agent-memory init'."}
        except RuntimeError as e:
            raise RuntimeError(f"Storage engine offline: {e}") from e
        should_close = True
    elif conn.row_factory is None:
        conn.row_factory = sqlite3.Row

    cur = None
    try:
        cur = conn.cursor()
        cur.row_factory = None
        if not clean_raw_query:
            sql = """
                SELECT o.observation_id, o.session_id, o.category, o.content, o.tags, o.confidence, o.created_at,
                       COALESCE(o.entity_name, e.name) as entity_name, e.type as entity_type,
                       0.0 as rank
                FROM observations o
                LEFT JOIN entities e ON o.entity_id = e.entity_id
                WHERE +o.category = ? COLLATE NOCASE
            """
            params: list[Any] = [parsed_category]
            if clean_sess:
                sql += " AND +o.session_id = ? COLLATE NOCASE"
                params.append(clean_sess)
            sql += " ORDER BY o.created_at DESC, o.seq DESC LIMIT ?"
            params.append(bounded_limit)
            rows = cur.execute(sql, params).fetchall()
            cur.close()
            cur = None
            return [_result_row(r, "category") for r in rows]

        if not parsed_category and not clean_sess:
            sql = """
                WITH matched AS (
                    SELECT rowid, bm25(observations_fts, 1.0, 0.0, 3.0, 4.0) as rank
                    FROM observations_fts
                    WHERE observations_fts MATCH ?
                    ORDER BY rank, rowid DESC
                    LIMIT ?
                )
                SELECT o.observation_id, o.session_id, o.category, o.content, o.tags, o.confidence, o.created_at,
                       COALESCE(o.entity_name, e.name) as entity_name, e.type as entity_type,
                       m.rank
                FROM matched m
                JOIN observations o ON m.rowid = o.seq
                LEFT JOIN entities e ON o.entity_id = e.entity_id
                ORDER BY m.rank, m.rowid DESC
            """
            params = [safe_query, bounded_limit]
        else:
            sql = """
                WITH matched AS (
                    SELECT fts.rowid, bm25(observations_fts, 1.0, 0.0, 3.0, 4.0) as rank
                    FROM observations_fts fts
                    JOIN observations o ON fts.rowid = o.seq
                    WHERE observations_fts MATCH ?
            """
            params = [safe_query]
            if parsed_category:
                sql += " AND +o.category = ? COLLATE NOCASE"
                params.append(parsed_category)
            if clean_sess:
                sql += " AND +o.session_id = ? COLLATE NOCASE"
                params.append(clean_sess)
            sql += """
                    ORDER BY rank, fts.rowid DESC
                    LIMIT ?
                )
                SELECT o.observation_id, o.session_id, o.category, o.content, o.tags, o.confidence, o.created_at,
                       COALESCE(o.entity_name, e.name) as entity_name, e.type as entity_type,
                       m.rank
                FROM matched m
                JOIN observations o ON m.rowid = o.seq
                LEFT JOIN entities e ON o.entity_id = e.entity_id
                ORDER BY m.rank, m.rowid DESC
            """
            params.append(bounded_limit)

        phrase_fallback = False
        try:
            rows = cur.execute(sql, params).fetchall()
        except sqlite3.OperationalError as op_err:
            err_msg = str(op_err).lower()
            if "no such table" in err_msg:
                raise RuntimeError(f"Database schema is incomplete ({op_err}). Run 'agent-memory init' to repair.") from op_err
            if any(k in err_msg for k in ("fts5", "syntax", "unterminated")):
                try:
                    params[0] = f'"{clean_raw_query.replace(chr(34), chr(34)+chr(34))}"'
                    rows = cur.execute(sql, params).fetchall()
                    phrase_fallback = True
                except sqlite3.OperationalError as e:
                    if "no such table" in str(e).lower():
                        raise RuntimeError(f"Database schema is incomplete ({e}). Run 'agent-memory init' to repair.") from e
                    return {"error": f"FTS search error: {e}"}
            else:
                return {"error": f"Search execution failed: {op_err}"}

        cur.close()
        cur = None
        active_match = "phrase_fallback" if phrase_fallback else ("all_terms" if plain else "query")
        results = [_result_row(r, active_match) for r in rows]
        if not results and plain and plain[1]:
            params[0] = plain[1]
            try:
                cur = conn.cursor()
                cur.row_factory = None
                results = [_result_row(r, "some_terms") for r in cur.execute(sql, params).fetchall()]
                cur.close()
                cur = None
            except sqlite3.OperationalError:
                pass
        return results
    except (sqlite3.Error, RuntimeError, OSError, ValueError, TypeError, ArithmeticError) as e:
        if isinstance(e, RuntimeError):
            raise
        return {"error": f"Search failed: {e}"}
    finally:
        if cur is not None:
            try:
                cur.close()
            except sqlite3.Error:
                pass
        if should_close and conn is not None:
            try:
                conn.close()
            except sqlite3.Error:
                pass

def recall_entity(name: str, session_id: str | None = None, limit: int | None = 20,
                  relation_limit: int | None = 50, category: str | None = None,
                  conn: sqlite3.Connection | None = None) -> dict[str, Any]:
    """Retrieve the entity profile, attributes, recent observations, and graph relationships for a named entity to establish system context, preventing agents from operating without entity history."""
    clean_name = _normalize_nfkc((name or "").replace("\x00", " ").strip()) if isinstance(name, str) else ""
    if not clean_name:
        return {"error": "Entity name cannot be empty."}
    if len(clean_name) > MAX_NAME_CHARS:
        return {"error": f"Entity name exceeds {MAX_NAME_CHARS} characters."}

    if session_id is not None:
        if not isinstance(session_id, str):
            return {"error": "Session ID must be a string."}
        clean_sess = session_id.replace("\x00", " ").strip()
        if not clean_sess:
            return {"error": "Session ID cannot be empty."}
        if len(clean_sess) > MAX_SESSION_CHARS:
            return {"error": f"Session ID exceeds {MAX_SESSION_CHARS} characters."}
    else:
        clean_sess = None

    clean_cat = None
    if category is not None:
        if not isinstance(category, str):
            return {"error": f"Invalid category. Must be one of: {sorted(VALID_CATEGORIES)}"}
        clean_cat = category.replace("\x00", " ").strip().lower()
        if not clean_cat or clean_cat not in VALID_CATEGORIES:
            return {"error": f"Invalid category '{clean_cat}'. Must be one of: {sorted(VALID_CATEGORIES)}"}

    if limit is None:
        bounded_limit = 20
    else:
        parsed_lim, lim_err = _parse_bounded_int(limit, "Limit", 1, 100)
        if lim_err or parsed_lim is None:
            return {"error": lim_err or "Limit must be an integer between 1 and 100."}
        bounded_limit = parsed_lim

    if relation_limit is None:
        bounded_rel_limit = 50
    else:
        parsed_rlim, rlim_err = _parse_bounded_int(relation_limit, "Relation limit", 1, 100)
        if rlim_err or parsed_rlim is None:
            return {"error": rlim_err or "Relation limit must be an integer between 1 and 100."}
        bounded_rel_limit = parsed_rlim

    should_close = False
    if conn is None:
        try:
            conn = get_connection(read_only=True)
        except FileNotFoundError:
            return {"error": f"Entity '{clean_name}' not found."}
        except RuntimeError as e:
            raise RuntimeError(f"Storage engine offline: {e}") from e
        should_close = True

    cur = None
    try:
        cur = conn.cursor()
        cur.row_factory = None
        with _Transaction(conn, "DEFERRED"):
            try:
                entity = cur.execute("SELECT entity_id, name, type, summary, attributes, created_at, updated_at FROM entities WHERE name = ? COLLATE NOCASE", (clean_name,)).fetchone()
            except sqlite3.OperationalError as e:
                if "no such table" in str(e).lower():
                    raise RuntimeError(f"Database schema is incomplete ({e}). Run 'agent-memory init' to repair.") from e
                raise
            if not entity:
                return {"error": f"Entity '{clean_name}' not found."}

            res: dict[str, Any] = {
                "entity_id": entity[0],
                "name": entity[1],
                "type": entity[2],
                "summary": entity[3],
                "attributes": _parse_cached_meta(entity[4]),
                "created_at": entity[5],
                "updated_at": entity[6]
            }

            obs_sql = """
                SELECT observation_id, session_id, category, content, tags, confidence, created_at
                FROM observations
                WHERE entity_id = ?
            """
            obs_params: list[Any] = [res["entity_id"]]
            if clean_sess:
                obs_sql += " AND session_id = ? COLLATE NOCASE"
                obs_params.append(clean_sess)
            if clean_cat:
                obs_sql += " AND category = ? COLLATE NOCASE"
                obs_params.append(clean_cat)
            obs_sql += " ORDER BY created_at DESC, seq DESC LIMIT ?"
            obs_params.append(bounded_limit + 1)

            obs_rows = cur.execute(obs_sql, obs_params).fetchall()
            res["has_more_observations"] = len(obs_rows) > bounded_limit
            res["observations"] = [
                {
                    "observation_id": r[0],
                    "session_id": r[1],
                    "category": r[2],
                    "content": r[3],
                    "tags": _parse_cached_tags(r[4]),
                    "confidence": float(r[5]),
                    "created_at": r[6]
                }
                for r in obs_rows[:bounded_limit]
            ]

            out_rows = cur.execute("""
                SELECT r.relation_id, r.relation_type, r.weight, r.metadata, r.created_at, r.updated_at, e.name as target_name, e.type as target_type
                FROM relations r
                JOIN entities e ON r.target_entity_id = e.entity_id
                WHERE r.source_entity_id = ?
                ORDER BY r.weight DESC, r.created_at DESC, r.rowid ASC
                LIMIT ?
            """, (res["entity_id"], bounded_rel_limit + 1)).fetchall()
            has_more_out = len(out_rows) > bounded_rel_limit
            if has_more_out:
                out_rows = out_rows[:bounded_rel_limit]
            res["outgoing_relations"] = [
                {
                    "relation_id": r[0], "relation_type": r[1], "weight": float(r[2]),
                    "metadata": _parse_cached_meta(r[3]), "created_at": r[4], "updated_at": r[5],
                    "target_name": r[6], "target_type": r[7]
                }
                for r in out_rows
            ]
            res["has_more_outgoing_relations"] = has_more_out

            in_rows = cur.execute("""
                SELECT r.relation_id, r.relation_type, r.weight, r.metadata, r.created_at, r.updated_at, e.name as source_name, e.type as source_type
                FROM relations r
                JOIN entities e ON r.source_entity_id = e.entity_id
                WHERE r.target_entity_id = ?
                ORDER BY r.weight DESC, r.created_at DESC, r.rowid ASC
                LIMIT ?
            """, (res["entity_id"], bounded_rel_limit + 1)).fetchall()
            has_more_in = len(in_rows) > bounded_rel_limit
            if has_more_in:
                in_rows = in_rows[:bounded_rel_limit]
            res["incoming_relations"] = [
                {
                    "relation_id": r[0], "relation_type": r[1], "weight": float(r[2]),
                    "metadata": _parse_cached_meta(r[3]), "created_at": r[4], "updated_at": r[5],
                    "source_name": r[6], "source_type": r[7]
                }
                for r in in_rows
            ]
            res["has_more_incoming_relations"] = has_more_in

            return res
    except (sqlite3.Error, RuntimeError, OSError, ValueError, TypeError, ArithmeticError) as e:
        if isinstance(e, RuntimeError):
            raise
        return {"error": f"Recall failed: {e}"}
    finally:
        if cur is not None:
            try:
                cur.close()
            except sqlite3.Error:
                pass
        if should_close and conn is not None:
            try:
                conn.close()
            except sqlite3.Error:
                pass

def _scrub_deleted(conn: sqlite3.Connection):
    """Purges deleted memory records by optimizing the FTS5 inverted index and checkpointing WAL frames to scrub residual data, preventing uncompacted segments and WAL frames from retaining deleted plaintext on disk."""
    try:
        try:
            conn.execute("INSERT INTO observations_fts(observations_fts) VALUES('optimize');")
        except (sqlite3.OperationalError, sqlite3.DatabaseError):
            pass

        conn.execute("PRAGMA busy_timeout = 250;")
        truncated = False
        for attempt in range(4):
            try:
                row = conn.execute("PRAGMA wal_checkpoint(TRUNCATE);").fetchone()
                if row and row[0] == 0:
                    truncated = True
                    break
            except sqlite3.OperationalError:
                pass
            time.sleep(0.05 * (attempt + 1))
        if not truncated:
            try:
                conn.execute("PRAGMA wal_checkpoint(PASSIVE);")
            except sqlite3.Error:
                pass
    except (sqlite3.Error, OSError):
        pass
    finally:
        try:
            conn.execute("PRAGMA busy_timeout = 5000;")
        except sqlite3.Error:
            pass

def _prune_orphan_stub_entities(conn: sqlite3.Connection, entity_ids: list[str] | set[str]) -> None:
    """Deletes auto-created `concept` stub entities that have zero remaining observations, relations, summary, or attributes, preventing orphaned stub rows after deletion."""
    for eid in entity_ids:
        if not eid:
            continue
        rem_obs = conn.execute("SELECT COUNT(*) FROM observations WHERE entity_id = ?", (eid,)).fetchone()[0]
        rem_rel = conn.execute(
            "SELECT COUNT(*) FROM relations WHERE source_entity_id = ? OR target_entity_id = ?",
            (eid, eid),
        ).fetchone()[0]
        if rem_obs == 0 and rem_rel == 0:
            ent_row = conn.execute(
                "SELECT summary, type, attributes FROM entities WHERE entity_id = ?",
                (eid,),
            ).fetchone()
            if ent_row and not ent_row[0] and ent_row[1] == "concept" and (not ent_row[2] or ent_row[2] == "{}"):
                conn.execute("DELETE FROM entities WHERE entity_id = ?", (eid,))

def forget_memory(observation_id: str | None = None, entity: str | None = None, source: str | None = None,
                  target: str | None = None, relation_type: str | None = None,
                  conn: sqlite3.Connection | None = None) -> dict[str, Any]:
    """Delete an observation, an entity with its attached facts and relations, or relation edges between two entities to prune obsolete knowledge, preventing stale facts from persisting in memory."""
    if observation_id is not None and not isinstance(observation_id, str):
        return {"error": "observation_id must be a string."}
    if entity is not None and not isinstance(entity, str):
        return {"error": "entity must be a string."}
    if source is not None and not isinstance(source, str):
        return {"error": "source must be a string."}
    if target is not None and not isinstance(target, str):
        return {"error": "target must be a string."}
    if relation_type is not None:
        if not isinstance(relation_type, str):
            return {"error": "relation_type must be a non-empty string."}
        if not relation_type.replace("\x00", " ").strip():
            return {"error": "relation_type cannot be empty when specified."}

    def _norm_name(v: str | None) -> str:
        """Normalizes an entity name with NFKC folding and NUL-byte replacement to standardize entity deletion lookups, preventing Unicode compatibility variants from bypassing forget operations."""
        return _normalize_nfkc(v).replace("\x00", " ").strip() if isinstance(v, str) else ""

    obs_id = observation_id.replace("\x00", " ").strip() if isinstance(observation_id, str) else ""
    ent = _norm_name(entity)
    src, tgt = _norm_name(source), _norm_name(target)
    rtype = relation_type.replace("\x00", " ").strip().lower() if isinstance(relation_type, str) else ""

    if observation_id is not None and not obs_id:
        return {"error": "observation_id cannot be empty."}
    if entity is not None and not ent:
        return {"error": "entity cannot be empty."}
    if source is not None and not src:
        return {"error": "source cannot be empty."}
    if target is not None and not tgt:
        return {"error": "target cannot be empty."}

    if max(len(obs_id), len(ent), len(src), len(tgt), len(rtype)) > MAX_NAME_CHARS:
        return {"error": f"Identifiers and entity names are limited to {MAX_NAME_CHARS} characters."}

    has_rel_args = bool(src or tgt or rtype)
    modes = [bool(obs_id), bool(ent), has_rel_args]
    if sum(modes) != 1:
        return {"error": "Specify exactly one of: observation_id, entity, or source+target (optionally relation_type)."}
    if has_rel_args and not (src and tgt):
        return {"error": "Forgetting a relation requires both source and target."}

    should_close = False
    try:
        if conn is None:
            _check_not_guarded_path(_RAW_DB_PATH, "Database path")
            if os.path.lexists(_RAW_DB_PATH):
                _require_owned(_RAW_DB_PATH, "Database file", forbid_group_other_write=True)
            enforce_storage_gate(os.path.realpath(DB_PATH), read_only=False, label="Database path")
            if not os.path.exists(DB_PATH):
                return {"error": f"No memory database at {DB_PATH}."}
            conn = get_connection()
            should_close = True
            try:
                uv_row = conn.execute("PRAGMA user_version;").fetchone()
                if not uv_row or uv_row[0] != SCHEMA_VERSION:
                    init_db(conn=conn)
                else:
                    conn.execute("SELECT 1 FROM observations LIMIT 1;")
            except sqlite3.OperationalError:
                init_db(conn=conn)
        conn.execute("PRAGMA foreign_keys = ON;")
        conn.execute("PRAGMA recursive_triggers = ON;")
        with _Transaction(conn, "IMMEDIATE"):
            if obs_id:
                obs_row = conn.execute("SELECT seq, entity_id FROM observations WHERE observation_id = ?", (obs_id,)).fetchone()
                if not obs_row:
                    raise _Abort(f"Observation '{obs_id}' not found.")
                n = conn.execute("DELETE FROM observations WHERE observation_id = ?", (obs_id,)).rowcount
                parent_eid = obs_row[1] if len(obs_row) > 1 else None
                if parent_eid:
                    _prune_orphan_stub_entities(conn, [parent_eid])
                result: dict[str, Any] = {"status": "success", "deleted_observations": n}
            elif ent:
                row = conn.execute("SELECT entity_id, name FROM entities WHERE name = ? COLLATE NOCASE", (ent,)).fetchone()
                if not row:
                    raise _Abort(f"Entity '{ent}' not found.")
                eid, canonical = row[0], row[1]
                neighbor_rows = conn.execute(
                    "SELECT source_entity_id FROM relations WHERE target_entity_id = ? "
                    "UNION SELECT target_entity_id FROM relations WHERE source_entity_id = ?",
                    (eid, eid),
                ).fetchall()
                neighbor_eids = [r[0] for r in neighbor_rows if r[0] != eid]
                n_obs = conn.execute("SELECT COUNT(*) FROM observations WHERE entity_id = ?", (eid,)).fetchone()[0]
                n_rel = conn.execute("SELECT COUNT(*) FROM relations WHERE source_entity_id = ? OR target_entity_id = ?", (eid, eid)).fetchone()[0]
                conn.execute("DELETE FROM entities WHERE entity_id = ?", (eid,))
                _prune_orphan_stub_entities(conn, neighbor_eids)
                result = {"status": "success", "deleted_entity": canonical,
                          "deleted_observations": n_obs, "deleted_relations": n_rel}
            else:
                ids = {}
                for label, nm in (("source", src), ("target", tgt)):
                    r = conn.execute("SELECT entity_id FROM entities WHERE name = ? COLLATE NOCASE", (nm,)).fetchone()
                    if not r:
                        raise _Abort(f"Entity '{nm}' not found.")
                    ids[label] = r[0]
                sql = "DELETE FROM relations WHERE source_entity_id = ? AND target_entity_id = ?"
                params = [ids["source"], ids["target"]]
                if rtype:
                    sql += " AND relation_type = ? COLLATE NOCASE"
                    params.append(rtype)
                n = conn.execute(sql, params).rowcount
                if n == 0:
                    raise _Abort("No matching relation found.")
                _prune_orphan_stub_entities(conn, [ids["source"], ids["target"]])
                result = {"status": "success", "deleted_relations": n}
        _scrub_deleted(conn)
        return result
    except _Abort as e:
        return {"error": str(e)}
    except (sqlite3.Error, RuntimeError, OSError, ValueError, TypeError, ArithmeticError) as e:
        return {"error": f"Forget failed: {e}"}
    finally:
        if should_close and conn is not None:
            try:
                conn.close()
            except sqlite3.Error:
                pass

_ENTITY_TYPES_ENUM = ["service", "repo", "pattern", "concept", "operator", "host"]
_CATEGORIES_ENUM = ["architecture", "decision", "invariant", "preference", "debug_finding"]

# Advertised MCP tool schemas list canonical parameter names only. The dispatcher still
# accepts legacy aliases (entity_name/name, type, session) for compatibility.
TOOLS = [
    {
        "name": "memory_record",
        "description": "Store one durable fact (decision, invariant, preference, architecture note, or debug finding), optionally attached to a named entity. Returns observation_id. If that entity already has the identical fact, returns the existing one with status=exists. Enforce the Hard Isolation Rule: record clinical technical prose only, with zero conversational persona names, titles, or stylistic flourishes.",
        "inputSchema": {
