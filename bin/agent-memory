"""Provides a per-user, Optane-backed SQLite knowledge graph and observation memory engine for AI coding agents to persist durable technical context across sessions, preventing context loss and unbounded prompt token growth."""


import sys

if __name__ == "__main__" and len(sys.argv) == 2 and sys.argv[1] in ("--version", "-v"):
    print("agent-memory 1.0.0 (schema 1.0, storage format 9)")
    sys.exit(0)

